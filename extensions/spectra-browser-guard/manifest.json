{
  "manifest_version": 3,
  "name": "Spectra Browser Guard & YouTube AdShield",
  "version": "2.0.0",
  "description": "High-performance YouTube video ad & annotation blocker, Shorts suppressor, and declarative stream guard powered by SpectraNetworkManager.",
  "author": "Biohazard Corp (Creator-NL)",
  "homepage_url": "https://biohazard-corp.nl/spectranetworkmanager.html",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browserguard@biohazard-corp.nl",
      "strict_min_version": "109.0"
    }
  }
}
