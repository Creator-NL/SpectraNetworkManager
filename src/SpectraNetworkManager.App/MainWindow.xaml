<Window x:Class="SpectraNetworkManager.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpectraNetworkManager" Width="1400" Height="800" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Bahnschrift" VerticalAlignment="Center">
                    <Run Text="Spectra" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                    <Run Text="NetworkManager" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                    <Run Text="  //  live network monitor" FontSize="14" Foreground="{StaticResource Magenta}"/>
                </TextBlock>
                <Border x:Name="AdminStateBadge" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="3"
                        ToolTip="Current privilege mode. Click 'Switch' to change modes.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminStateIcon" Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdminStateText" Text="ADMINISTRATOR" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border x:Name="DnsBadge" Visibility="Collapsed" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="3">
                    <TextBlock Text="DNS ON" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                </Border>
                <Border x:Name="StrictBadge" Visibility="Collapsed" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="3">
                    <TextBlock Text="STRICT MODE ON" FontWeight="SemiBold" Foreground="{StaticResource Amber}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SwitchElevationButton" Content="Restart in Normal Mode" Margin="0,0,10,0" Click="OnSwitchElevationClick"
                        ToolTip="Restart SpectraNetworkManager in standard user mode without Administrator privileges."/>
                <Button x:Name="UpdateBadge" Content="Update Available" Visibility="Collapsed" Margin="0,0,10,0"
                        Foreground="{StaticResource Cyan}" Click="OnUpdateBadgeClick" ToolTip="Click to view update details on GitHub"/>
                <Button x:Name="HeaderDnsButton" Content="▶ Start DNS" Margin="0,0,10,0" Padding="12,4" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Click="OnHeaderDnsClick" ToolTip="Quickly start or stop the DNS Sinkhole Server from any tab"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar & Navigation Row -->
        <DockPanel Grid.Row="1" Margin="0,12,0,6" LastChildFill="True">
            <!-- Settings Cogwheel (Docked to the Right, directly below Stop DNS) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="SettingsButton" Content="⚙️ Settings" Padding="12,5" FontWeight="SemiBold"
                        Click="OnToggleSettingsPopup" ToolTip="Application settings, language, and preferences"/>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="16,14" Width="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <TextBlock x:Name="SettingsTitleText" Text="⚙️ SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontFamily="Bahnschrift"/>
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseSettingsPopup" Padding="6,1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"/>
                            </DockPanel>

                            <!-- Language Selector -->
                            <TextBlock x:Name="SettingsLanguageText" Text="Interface Language / Taal" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="LanguageCombo" Margin="0,0,0,14" SelectionChanged="OnLanguageSelectionChanged" ToolTip="Select interface language / Kies interfacetaal">
                                <ComboBoxItem Content="🌐 Auto (System)" Tag="Auto" IsSelected="True"/>
                                <ComboBoxItem Content="🇬🇧 English" Tag="English"/>
                                <ComboBoxItem Content="🇳🇱 Nederlands" Tag="Nederlands"/>
                            </ComboBox>

                            <Separator Background="{StaticResource Line}" Margin="0,0,0,12"/>

                            <!-- Preferences Checkboxes -->
                            <CheckBox x:Name="AskMode" Content="Ask about new programs" IsChecked="True" Margin="0,0,0,10"
                                      Checked="OnAskModeChanged" Unchecked="OnAskModeChanged"
                                      ToolTip="Shows an Allow / Block question when a program without a decision first reaches the internet. Nothing is blocked until you answer Block."/>

                            <CheckBox x:Name="AlwaysAdminCheck" Content="Always run as admin" Margin="0,0,0,10"
                                      Checked="OnAlwaysAdminChanged" Unchecked="OnAlwaysAdminChanged"
                                      ToolTip="When checked, SpectraNetworkManager will automatically request Administrator elevation on launch."/>

                            <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top" Margin="0,0,0,10"
                                      Checked="OnAlwaysOnTopChanged" Unchecked="OnAlwaysOnTopChanged"
                                      ToolTip="Keep SpectraNetworkManager window on top of all other windows."/>

                            <CheckBox x:Name="NotificationSoundCheck" Content="Alert sounds" Margin="0,0,0,4"
                                      Checked="OnNotificationSoundChanged" Unchecked="OnNotificationSoundChanged"
                                      ToolTip="Play alert sounds for network prompts. Uncheck to silence all notification sounds."/>

                            <Separator Background="{StaticResource Line}" Margin="0,12,0,12"/>

                            <!-- Maintenance & Tools -->
                            <TextBlock x:Name="SettingsMaintenanceText" Text="Maintenance &amp; Tools" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                            <Button x:Name="SystemAuditButton" Content="🩺 Audit System &amp; Settings..." Margin="0,0,0,8" Padding="10,6" HorizontalContentAlignment="Left"
                                    Foreground="{StaticResource Cyan}" Click="OnSystemAuditClick" ToolTip="Audit all security settings, rules, and configurations with 1-click repairs"/>
                            <Button x:Name="CleanDataButton" Content="🧹 Clean Stored Data..." Padding="10,6" HorizontalContentAlignment="Left"
                                    Click="OnCleanStoredDataClick" ToolTip="Clean DNS history, network history, and temporary logs while preserving custom rules"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="ConnectionsTab" Content="Connections" GroupName="view" IsChecked="True"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="ProgramsTab" Content="Programs" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="StartupTab" Content="Startup" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="TrafficTab" Content="Traffic" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="ScannerTab" Content="Port Scanner" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="PacketsTab" Content="Packets" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"
                             ToolTip="Live native packet inspector, TLS SNI &amp; protocol dissector, hex stream viewer, and Wireshark PCAPNG export."/>
                <RadioButton x:Name="TvMobileTab" Content="TV &amp; Mobile" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"
                             ToolTip="Smart TV ACR viewing telemetry blocker, GSM mobile defense hub, and remote companion pairing."/>
                <RadioButton x:Name="BrowserGuardTab" Content="Browser Guard" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"
                             ToolTip="Native URL &amp; video blocker, YouTube Shorts blocker, and Manifest V3 browser extension controls."/>
                <RadioButton x:Name="AiTab" Content="Spectra AI" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"
                             ToolTip="Evidence-based process investigation, threat attribution, and local AI threat assessment."/>
                <RadioButton x:Name="RulesTab" Content="Rules" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="QuarantineTab" Content="Quarantine" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"
                             ToolTip="Active Defense Quarantine Vault. Inspect and restore quarantined applications."/>
                <RadioButton x:Name="StrictTab" Content="Strict mode" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="DnsTab" Content="DNS" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
                <RadioButton x:Name="BlocksTab" Content="Firewall blocks" GroupName="view"
                             Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            </WrapPanel>
        </DockPanel>

        <!-- Ask mode: decision bar -->
        <Border x:Name="DecisionBar" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,10" Padding="14,10"
                Background="{StaticResource Selected}" BorderBrush="{StaticResource Magenta}" BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="AskAllowButton" Content="Allow" Margin="0,0,8,0" Click="OnAskAllow"/>
                    <Button x:Name="AskBlockButton" Content="Block..." Margin="0,0,8,0" Click="OnAskBlock" Foreground="{StaticResource Magenta}"/>
                    <Button x:Name="AskTrustButton" Content="Trust publisher" Margin="0,0,8,0" Click="OnAskTrust" Visibility="Collapsed"
                            ToolTip="Allow this and stop asking about anything with a verified signature from the same publisher."/>
                    <Button x:Name="AskLaterButton" Content="Later" Click="OnAskLater"
                            ToolTip="Decide later. The program stays marked NEW in the Programs view."/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="AskTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AskDetail" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Text}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connections view -->
        <Grid x:Name="ConnectionsPanel" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Connections Toolbar -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid Width="290" Margin="0,0,20,0">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                             ToolTip="Filter by program, address, host name, port or PID"/>
                    <TextBlock Text="Search program, address, port, PID..." IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- "__" shows a single underscore (a single one would be eaten as a keyboard shortcut marker) -->
                <CheckBox x:Name="HideNoise" Content="Hide TIME__WAIT / closing" IsChecked="True"
                          Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="ShowListeners" Content="Show listening ports" IsChecked="True"
                          Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="ResolveHosts" Content="Resolve host names" IsChecked="True"
                          Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnResolveHostsChanged"
                          ToolTip="Looks up a name for each remote IP using your DNS server (reverse DNS)."/>
            </WrapPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ConnectionsGrid" Grid.Row="0" ItemsSource="{Binding Rows}"
                              SelectionMode="Single"
                              SelectionChanged="OnConnectionsGridSelectionChanged"
                              PreviewMouseLeftButtonUp="OnConnectionsGridMouseUp">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                                <Separator/>
                                <MenuItem Header="Close This Connection" Click="OnCloseSelectedConnection"/>
                                <MenuItem Header="Close All Connections for Program" Click="OnCloseConnectionProgram"/>
                                <MenuItem Header="End Process (Kill)" Click="OnKillConnectionProcess"/>
                                <MenuItem Header="🛑 Stop Windows Service..." Click="OnStopConnectionService"/>
                                <Separator/>
                                <MenuItem Header="Block Program..." Click="OnBlockConnectionProgram"/>
                                <MenuItem Header="Allow Program" Click="OnAllowConnectionProgram"/>
                                <MenuItem x:Name="ConnectionMenuQuarantine" Header="🛡️ 5-Stage Quarantine Program..." Click="OnQuarantineConnectionProgram" Foreground="{StaticResource Magenta}"/>
                                <MenuItem Header="⚡ Limit Upload Speed..." Click="OnSetConnectionUploadLimit" Foreground="{StaticResource Cyan}"/>
                                <Separator/>
                                <MenuItem Header="🛡️ Check File Hash on VirusTotal" Click="OnCheckConnectionVirusTotal" Foreground="{StaticResource MenuBlue}"/>
                                <MenuItem Header="📋 Copy SHA-256 Hash" Click="OnCopyConnectionSha256"/>
                                <MenuItem Header="🚨 Check Remote IP on AbuseIPDB" Click="OnCheckConnectionAbuseIpDb" Foreground="{StaticResource Amber}"/>
                                <MenuItem Header="🔎 Check Remote IP on Shodan" Click="OnCheckConnectionShodan"/>
                                <Separator/>
                                <MenuItem Header="Copy Remote Address" Click="OnCopyConnectionRemote"/>
                                <MenuItem Header="Open File Location" Click="OnOpenConnectionLocation"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol, Mode=OneWay}" Width="65"/>
                            <DataGridTextColumn Header="PROGRAM" Binding="{Binding Program, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="SERVICE / PARENT" Binding="{Binding ServiceOrParent, Mode=OneWay}" Width="180"/>
                            <DataGridTextColumn Header="IN/s" Binding="{Binding SpeedIn, Mode=OneWay}" Width="75"/>
                            <DataGridTextColumn Header="OUT/s" Binding="{Binding SpeedOut, Mode=OneWay}" Width="75"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="LOCAL" Binding="{Binding Local, Mode=OneWay}" Width="180"/>
                            <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote, Mode=OneWay}" Width="190"/>
                            <DataGridTextColumn Header="HOST" Binding="{Binding Host, Mode=OneWay}" Width="210"/>
                            <DataGridTextColumn Header="NETWORK / ASN" Binding="{Binding RemoteIntel, Mode=OneWay}" Width="210"/>
                            <DataGridTextColumn Header="STATE" Binding="{Binding State, Mode=OneWay}" Width="115"/>
                            <DataGridTextColumn Header="SIGNER" Binding="{Binding Signer, Mode=OneWay}" Width="210"/>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- PROCESS & CONNECTION INTELLIGENCE INSPECTOR PANEL -->
                    <Border x:Name="ConnectionInspectorPanel" Grid.Row="1" Visibility="Collapsed"
                            Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="14,10">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseConnectionInspector"
                                        Padding="0" Width="28" Height="24"
                                        Background="#1A2140" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="12"
                                        Cursor="Hand" ToolTip="Close details panel"
                                        VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PROCESS &amp; CONNECTION INTELLIGENCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="  //  Process Attribution (Parent / Service / SHA-256) ➔ Remote Network &amp; ASN" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CARD: PROCESS ATTRIBUTION & IDENTITY -->
                                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <Border x:Name="ConnInspectorIdentityBadge" DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Background="#2222E8FF">
                                                <TextBlock x:Name="ConnInspectorIdentityText" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                            </Border>
                                            <TextBlock Text="PROCESS ATTRIBUTION &amp; IDENTITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Program / PID:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorProgramText" FontSize="11" Foreground="{StaticResource Cyan}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Service / Parent:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorServiceParentText" FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Command Line:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorCommandLineText" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="SHA-256 Hash:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorSha256Text" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- MIDDLE DIRECTIONAL ARROW -->
                                <TextBlock Grid.Column="1" Text="➔" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                                           VerticalAlignment="Center" Margin="10,0"/>

                                <!-- RIGHT CARD: REMOTE PEER & NETWORK INTELLIGENCE -->
                                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <Border x:Name="ConnInspectorScopeBadge" DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Background="#22FF2BD6">
                                                <TextBlock x:Name="ConnInspectorScopeText" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                                            </Border>
                                            <TextBlock Text="REMOTE PEER &amp; NETWORK INTELLIGENCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Flow / State:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorEndpointText" FontSize="11" Foreground="{StaticResource Cyan}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Hostname:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorHostText" FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Network / ASN:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorAsnText" FontSize="11" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="Executable Path:" FontSize="11" Foreground="{StaticResource Muted}" Width="98"/>
                                            <TextBlock x:Name="ConnInspectorPathText" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <WrapPanel>
                                <Button Content="🛡️ Check Hash on VirusTotal" Click="OnCheckConnectionVirusTotal" Margin="0,0,8,0" Foreground="{StaticResource Cyan}"
                                        ToolTip="Opens VirusTotal file analysis for this executable's SHA-256 hash."/>
                                <Button Content="📋 Copy SHA-256" Click="OnCopyConnectionSha256" Margin="0,0,8,0"
                                        ToolTip="Copies the executable's cryptographic SHA-256 hash to the clipboard."/>
                                <Button x:Name="ConnInspectorAbuseIpBtn" Content="🚨 Check IP on AbuseIPDB" Click="OnCheckConnectionAbuseIpDb" Margin="0,0,8,0" Foreground="{StaticResource Amber}"
                                        ToolTip="Checks remote IP reputation and abuse reports on AbuseIPDB."/>
                                <Button x:Name="ConnInspectorShodanBtn" Content="🔎 Check IP on Shodan" Click="OnCheckConnectionShodan" Margin="0,0,8,0"
                                        ToolTip="Inspects open ports and ASN metadata for this remote IP on Shodan."/>
                                <Button Content="🛑 Stop Service..." Click="OnStopConnectionService" Margin="0,0,8,0"
                                        ToolTip="Stops the Windows Service hosted by this process (if any)."/>
                                <Button Content="🚫 Block Program..." Click="OnBlockConnectionProgram" Margin="0,0,8,0" Foreground="{StaticResource Magenta}"
                                        ToolTip="Blocks this program in Windows Firewall."/>
                                <Button Content="📂 Open File Location" Click="OnOpenConnectionLocation" Margin="0,0,8,0"
                                        ToolTip="Selects the executable in Windows Explorer."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LIVE EVENTS" Margin="12,10,12,6" FontWeight="SemiBold"
                                   Foreground="{StaticResource Magenta}"/>
                        <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="4,1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Opened}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Alert}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Programs view -->
        <Grid x:Name="ProgramsPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Nothing is blocked unless you say so. Programs that reach the internet without a decision are marked NEW (magenta). 'Allow' only records your decision; 'Block' adds Windows Firewall rules (needs Administrator). All decisions, including for programs that are not running, are in the Rules view."/>
            <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                <Grid Width="260" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBox x:Name="ProgramsSearchBox" VerticalContentAlignment="Center" TextChanged="OnProgramsFilterChanged"
                             ToolTip="Filter programs by name, path, or publisher"/>
                    <TextBlock Text="Search program, path, publisher..." IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ProgramsSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="AllowButton" Content="Allow" Margin="0,0,8,0" Click="OnAllowProgram"
                        ToolTip="Record that this program is OK. Removes a block if there was one."/>
                <Button x:Name="BlockButton" Content="Block..." Margin="0,0,8,0" Click="OnBlockProgram"
                        ToolTip="Block this program's inbound and outbound traffic using Windows Firewall."/>
                <Button x:Name="CloseConnectionsButton" Content="Close connections" Margin="0,0,8,0" Click="OnCloseProgramConnections"
                        ToolTip="Immediately terminate all open IPv4 TCP connections currently active for the selected program."/>

                <Button x:Name="StopProgramServiceButton" Content="Stop service" Margin="0,0,8,0" Click="OnStopProgramService"
                        ToolTip="Stops the Windows Service associated with the selected program (if running as a service)."/>
                <Button x:Name="ForgetButton" Content="Forget decision" Margin="0,0,8,0" Click="OnForgetProgram"
                        ToolTip="Remove your decision (and the block, if any) for this program."/>
                <Button x:Name="TrustButton" Content="Trust publisher" Margin="0,0,8,0" Click="OnTrustPublisher"
                        ToolTip="Stop asking about programs from this publisher. Only works for a verified signature, and your own Block decisions still win."/>
                <Button x:Name="PanicButton" Content="PANIC: undo all SpectraNetworkManager changes" DockPanel.Dock="Right" Click="OnPanic"
                        Foreground="{StaticResource Magenta}"
                        ToolTip="Switches strict mode off and deletes every Windows Firewall rule SpectraNetworkManager created."/>
            </DockPanel>
            <DataGrid x:Name="ProgramsGrid" Grid.Row="2" ItemsSource="{Binding Programs}" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                        <Separator/>
                        <MenuItem Header="Close Open Connections" Click="OnCloseProgramConnections"/>
                        <MenuItem Header="End Process (Kill)" Click="OnKillProgramProcess"/>
                        <MenuItem Header="🛑 Stop Windows Service..." Click="OnStopProgramService"/>
                        <Separator/>
                        <MenuItem Header="Block..." Click="OnBlockProgram"/>
                        <MenuItem Header="Allow" Click="OnAllowProgram"/>
                        <MenuItem x:Name="ProgramMenuQuarantine" Header="🛡️ 5-Stage Quarantine Program..." Click="OnQuarantineProgram" Foreground="{StaticResource Magenta}"/>
                        <MenuItem Header="🔄 Restore from Quarantine..." Click="OnRestoreProgramQuarantine" Foreground="{StaticResource MenuBlue}"/>
                        <MenuItem Header="⚡ Limit Upload Speed..." Click="OnSetProgramUploadLimit" Foreground="{StaticResource Cyan}"/>
                        <Separator/>
                        <MenuItem Header="🛡️ Check File Hash on VirusTotal" Click="OnCheckProgramVirusTotal" Foreground="{StaticResource MenuBlue}"/>
                        <MenuItem Header="📋 Copy SHA-256 Hash" Click="OnCopyProgramSha256"/>
                        <Separator/>
                        <MenuItem Header="Open File Location" Click="OnOpenProgramLocation"/>
                        <MenuItem Header="Copy Program Path" Click="OnCopyProgramPath"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROGRAM" Binding="{Binding Name, Mode=OneWay}" Width="200"/>
                    <DataGridTextColumn Header="DECISION" Binding="{Binding Verdict, Mode=OneWay}" Width="160"/>
                    <DataGridTextColumn Header="IN/s" Binding="{Binding SpeedIn, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="OUT/s" Binding="{Binding SpeedOut, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="INTERNET PEERS" Binding="{Binding InternetPeers, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="ESTABLISHED" Binding="{Binding Established, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="LISTENING" Binding="{Binding Listening, Mode=OneWay}" Width="95"/>
                    <DataGridTextColumn Header="UDP" Binding="{Binding UdpEndpoints, Mode=OneWay}" Width="60"/>
                    <DataGridTextColumn Header="PROCS" Binding="{Binding Processes, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="SIGNER" Binding="{Binding Signer, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Startup Manager view -->
        <Grid x:Name="StartupPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Shows every auto-start entry registered in Windows Registry (Run / RunOnce / Policies across 64-bit, 32-bit WOW6432Node, and Current User), Startup folders, and Windows Task Scheduler (Logon / Boot / Background tasks) — including hidden launchers not shown in Windows Settings. 'Turn Off (Disable)' safely disables an entry so you can re-enable it later; 'Remove Permanently' deletes it completely."/>
            <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                <Grid Width="280" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBox x:Name="StartupSearchBox" VerticalContentAlignment="Center" TextChanged="OnStartupFilterChanged"
                             ToolTip="Filter startup entries by name, publisher, location, or path"/>
                    <TextBlock Text="Search startup name, path, publisher, location..." IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=StartupSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button x:Name="DisableStartupButton" Content="⏸ Turn Off (Disable)" Margin="0,0,8,0" Click="OnDisableStartupItem"
                        Foreground="{StaticResource Amber}"
                        ToolTip="Disables the selected auto-start item without deleting it permanently, so you can re-enable it anytime."/>
                <Button x:Name="EnableStartupButton" Content="▶ Turn On (Enable)" Margin="0,0,8,0" Click="OnEnableStartupItem"
                        Foreground="{StaticResource Cyan}"
                        ToolTip="Restores and enables a previously disabled auto-start item."/>
                <Button x:Name="BlockStartupButton" Content="🚫 Block in Firewall..." Margin="0,0,8,0" Click="OnBlockStartupItem"
                        Foreground="{StaticResource Magenta}"
                        ToolTip="Blocks the startup executable from accessing the network using Windows Firewall."/>
                <Button x:Name="OpenStartupLocationButton" Content="📂 Open File Location" Margin="0,0,8,0" Click="OnOpenStartupLocation"
                        ToolTip="Opens Windows Explorer and selects the startup executable on disk."/>
                <Button x:Name="RefreshStartupButton" Content="🔄 Refresh" Margin="0,0,8,0" Click="OnRefreshStartupItems"
                        ToolTip="Re-scans Registry Run keys and Startup folders."/>
                <Button x:Name="DeleteStartupButton" Content="🗑️ Remove Permanently" DockPanel.Dock="Right" Click="OnDeleteStartupItem"
                        Foreground="{StaticResource Magenta}"
                        ToolTip="Permanently deletes this auto-start entry from the Registry or Startup folder."/>
            </DockPanel>
            <DataGrid x:Name="StartupGrid" Grid.Row="2" ItemsSource="{Binding StartupItems}" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                        <Separator/>
                        <MenuItem Header="⏸ Turn Off (Disable)" Click="OnDisableStartupItem"/>
                        <MenuItem Header="▶ Turn On (Enable)" Click="OnEnableStartupItem"/>
                        <Separator/>
                        <MenuItem Header="🚫 Block Executable in Firewall..." Click="OnBlockStartupItem" Foreground="{StaticResource Magenta}"/>
                        <MenuItem Header="🛡️ Check File Hash on VirusTotal" Click="OnCheckStartupVirusTotal" Foreground="{StaticResource MenuBlue}"/>
                        <MenuItem Header="📋 Copy SHA-256 Hash" Click="OnCopyStartupSha256"/>
                        <MenuItem Header="📂 Open File Location" Click="OnOpenStartupLocation"/>
                        <MenuItem Header="📋 Copy Command / Path" Click="OnCopyStartupCommand"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Remove Entry Permanently..." Click="OnDeleteStartupItem" Foreground="{StaticResource Magenta}"/>
                        <MenuItem Header="🔄 Refresh List" Click="OnRefreshStartupItems"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnsigned}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status, Mode=OneWay}" Width="115"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=OneWay}" Width="210"/>
                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher, Mode=OneWay}" Width="220"/>
                    <DataGridTextColumn Header="FIREWALL" Binding="{Binding FirewallStatus, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="LOCATION" Binding="{Binding Location, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="COMMAND / PATH" Binding="{Binding Command, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Traffic & Bandwidth view -->
        <Grid x:Name="TrafficPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Traffic Toolbar & Controls -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="Time range:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="TrafficRange1h" Content="1 Hour" GroupName="trafficRange" IsChecked="True"
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <RadioButton x:Name="TrafficRange24h" Content="24 Hours" GroupName="trafficRange"
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <RadioButton x:Name="TrafficRange7d" Content="7 Days" GroupName="trafficRange"
                                 Margin="0,0,20,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <Button Content="Refresh" Padding="14,3" Margin="0,0,10,0" Click="OnRefreshTraffic"/>
                    <Button Content="Export" Padding="14,3" Margin="0,0,10,0" Click="OnExportTraffic" ToolTip="Export Traffic data to CSV or JSON format."/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Copy Support Info" Padding="12,3" Foreground="{StaticResource Cyan}" Click="OnCopySupportInfo"
                            ToolTip="Copies a sanitized system and SpectraNetworkManager diagnostics report to clipboard with personal user paths redacted."/>
                </StackPanel>
            </DockPanel>

            <!-- Splitter: Top Talkers vs Connection History -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Top Talkers -->
                <GroupBox Grid.Column="0" Header="TOP TALKERS" Foreground="{StaticResource Cyan}" BorderBrush="{StaticResource Line}">
                    <DataGrid x:Name="TopTalkersGrid" ItemsSource="{Binding TopTalkers}" Margin="4" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROGRAM" Binding="{Binding ProgramName, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="IN" Binding="{Binding DownloadFormatted, Mode=OneWay}" SortMemberPath="BytesIn" Width="90"/>
                            <DataGridTextColumn Header="OUT" Binding="{Binding UploadFormatted, Mode=OneWay}" SortMemberPath="BytesOut" Width="90"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFormatted, Mode=OneWay}" SortMemberPath="TotalBytes" Width="90"/>
                            <DataGridTextColumn Header="LAST ACTIVE" Binding="{Binding LastActiveFormatted, Mode=OneWay}" SortMemberPath="LastActive" Width="120"/>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Program, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- Right: Connection History -->
                <GroupBox Grid.Column="2" Header="RECENT CONNECTION HISTORY" Foreground="{StaticResource Magenta}" BorderBrush="{StaticResource Line}">
                    <DataGrid x:Name="ConnectionHistoryGrid" ItemsSource="{Binding ConnectionHistory}" Margin="4" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROGRAM" Binding="{Binding ProgramName, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="PORT" Binding="{Binding Port, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="PROTO" Binding="{Binding Proto, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeenFormatted, Mode=OneWay}" SortMemberPath="LastSeen" Width="120"/>
                            <DataGridTextColumn Header="FIRST SEEN" Binding="{Binding FirstSeenFormatted, Mode=OneWay}" SortMemberPath="FirstSeen" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
            <!-- Bottom: Live Bandwidth Card -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8" Background="{StaticResource PanelAlt}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="LIVE BANDWIDTH" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⬇ DL: " Foreground="{StaticResource Cyan}" FontWeight="SemiBold" FontSize="11"/>

                                <TextBlock x:Name="LiveDownloadSpeedText" Text="0.0 KB/s" Foreground="{StaticResource Cyan}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⬆ UL: " Foreground="{StaticResource Magenta}" FontWeight="SemiBold" FontSize="11"/>

                                <TextBlock x:Name="LiveUploadSpeedText" Text="0.0 KB/s" Foreground="{StaticResource Magenta}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊 SESSION: " Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="11"/>

                                <TextBlock x:Name="SessionTrafficText" Text="0 MB" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="LiveTrafficInterfaceText" Text="Monitoring active interfaces" Foreground="{StaticResource Muted}"
                               FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Port Scanner & Network Discovery view -->
        <Grid x:Name="ScannerPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Description -->
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Native Port Scanner &amp; LAN Device Discovery. Automatically fingerprints Smart TVs, Mobile/GSM devices, Routers, and Workstations using hardware MAC OUI, hostnames, and service banners. Bounded and rate-limited. Click 'Passive Discovery' for an instant snapshot without sending network probes, or select a port profile for an active LAN scan."/>

            <!-- Toolbar & Controls -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="Target:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <TextBox x:Name="ScannerTargetBox" Width="170" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Subnet CIDR (e.g. 192.168.1.0/24), single IP, or 'local'"/>

                    <TextBlock Text="Profile:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ScannerProfileCombo" Width="195" VerticalAlignment="Center" Margin="0,0,14,0" SelectedIndex="0">
                        <ComboBoxItem Content="Top 20 Ports (Fastest)" ToolTip="Probes the top 20 most common network ports (HTTP, HTTPS, DNS, SSH, SMB, RDP, etc.) in ~2-5 seconds"/>
                        <ComboBoxItem Content="Top 100 Ports (Recommended)" ToolTip="Recommended: Audits 100 common service, database, and streaming ports across active LAN hosts"/>
                        <ComboBoxItem Content="Passive Discovery (Instant)" ToolTip="Instant snapshot reading ARP tables and routing without transmitting active TCP packets"/>
                        <ComboBoxItem Content="Local Machine (All Sockets)" ToolTip="Audits all local listening TCP and UDP sockets directly from the Windows OS kernel"/>
                    </ComboBox>

                    <Button x:Name="StartScanButton" Content="▶ Start Scan" Padding="14,3" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Click="OnStartScan" ToolTip="Begin scanning the target subnet for responsive hosts and open ports"/>
                    <Button x:Name="StopScanButton" Content="⏹ Stop" Padding="12,3" Margin="0,0,8,0" IsEnabled="False" Click="OnStopScan" ToolTip="Abort the active port scan"/>
                    <Button x:Name="PassiveDiscoverButton" Content="⚡ Passive (Instant)" Padding="12,3" Margin="0,0,14,0" Click="OnPassiveDiscovery" ToolTip="Instant neighbor &amp; ARP discovery without sending network packets"/>

                    <ProgressBar x:Name="ScannerProgressBar" Width="120" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ScannerStatusText" Text="Ready to scan." VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Export CSV" Padding="12,3" Margin="0,0,8,0" Click="OnExportScannerCsv" ToolTip="Export scan results to CSV"/>
                    <Button Content="Export JSON" Padding="12,3" Click="OnExportScannerJson" ToolTip="Export scan results to JSON"/>
                </StackPanel>
            </DockPanel>

            <!-- Row 2: Cyber Telemetry HUD & Real-Time Discovery Feed -->
            <Border Grid.Row="2" Margin="0,0,0,8" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Telemetry Cards Deck -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Radar & Target Scope -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="HudRadarBadge" DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Background="#2222E8FF" VerticalAlignment="Center">
                                    <TextBlock x:Name="HudRadarBadgeText" Text="STANDBY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SCANNER RADAR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                    <TextBlock x:Name="HudTargetText" Text="Target: Ready" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Card 2: Progress & Velocity -->
                        <Border Grid.Column="1" Margin="0,0,6,0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="PROGRESS &amp; SPEED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                        <TextBlock x:Name="HudEtaText" DockPanel.Dock="Right" Text="ETA: --" FontSize="10" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock x:Name="HudHostsRatioText" Text="0 / 0 Hosts" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock x:Name="HudVelocityText" Text="0.0 h/s" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="VELOCITY" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Discovered Devices -->
                        <Border Grid.Column="2" Margin="0,0,6,0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="HudDevicesCountText" DockPanel.Dock="Right" Text="0" FontSize="16" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISCOVERED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Active Devices" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Card 4: Open Ports Identified -->
                        <Border Grid.Column="3" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="HudPortsCountText" DockPanel.Dock="Right" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Magenta}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OPEN PORTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="Services Found" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Real-Time Activity Ticker (Mini Terminal) -->
                    <Border Grid.Row="1" Background="#0C101C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LIVE DISCOVERY FEED ▶ " FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontFamily="Consolas, monospace" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HudActivityTickerText" Grid.Column="1" Text="Scanner ready. Click 'Start Scan' to begin real-time host exploration." FontSize="10" Foreground="{StaticResource Text}" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter: Discovered Devices Grid (Left) vs Device & Port Inspector (Right) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Discovered Devices Grid -->
                <DataGrid x:Name="DevicesGrid" Grid.Column="0" ItemsSource="{Binding DiscoveredDevices}" SelectionMode="Single"
                          SelectionChanged="OnDevicesGridSelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔍 Scan This Host" Click="OnRescanSelectedHost"/>
                            <MenuItem Header="🛡️ Protect Host (DNS Filter)" Click="OnProtectDeviceWithDns"/>
                            <Separator/>
                            <MenuItem Header="📋 Copy IP Address" Click="OnCopyDeviceIp"/>
                            <MenuItem Header="📋 Copy MAC Address" Click="OnCopyDeviceMac"/>
                            <Separator/>
                            <MenuItem Header="🌐 Open in Web Browser" Click="OnOpenDeviceInBrowser"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding KindDisplay, Mode=OneWay}" Width="170">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="DEVICE TYPE" ToolTip="Hardware and OS classification based on MAC OUI vendor, hostname signatures, and service heuristics"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding IpString, Mode=OneWay}" Width="130">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="IP ADDRESS" ToolTip="IPv4 address of the discovered device"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Hostname, Mode=OneWay}" Width="170">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="HOSTNAME" ToolTip="Host name resolved via Reverse DNS (PTR), mDNS, or NetBIOS"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding MacString, Mode=OneWay}" Width="140">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="MAC ADDRESS" ToolTip="Physical MAC hardware address from the ARP table"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Vendor, Mode=OneWay}" Width="170">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="VENDOR" ToolTip="Hardware manufacturer name resolved from IEEE OUI database"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding OpenPortsSummary, Mode=OneWay}" Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="OPEN PORTS" ToolTip="Active TCP/UDP listening services discovered during the scan"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- Right: Device & Port Inspector Card -->
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <DockPanel LastChildFill="True">
                        <!-- Top: Device Header & Identity -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Border x:Name="DeviceTypeBadge" DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Background="#2222E8FF">
                                    <TextBlock x:Name="DeviceTypeBadgeText" Text="NETWORK DEVICE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                </Border>
                                <TextBlock Text="HOST &amp; PORT INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontFamily="Bahnschrift"/>
                            </DockPanel>

                            <TextBlock x:Name="InspectorDeviceNameText" Text="Select a device to inspect" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="InspectorDeviceDescText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="IP Address:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorDeviceIpText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                        <TextBlock Text="MAC / OUI:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorDeviceMacText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Resolved Hostname:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorDeviceHostText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Classification Reason:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorDeviceReasonText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="🛡️ Protect (DNS)" Margin="0,0,6,4" Click="OnProtectDeviceWithDns" Foreground="{StaticResource Cyan}" ToolTip="Add this device to DNS Protection"/>
                                <Button Content="🔍 Rescan Host" Margin="0,0,6,4" Click="OnRescanSelectedHost" ToolTip="Run detailed port scan on this specific device"/>
                                <Button Content="🌐 Open Browser" Margin="0,0,6,4" Click="OnOpenDeviceInBrowser" ToolTip="Open http://[IP] in default web browser"/>
                                <Button Content="📋 Copy Details" Margin="0,0,6,4" Click="OnCopyDeviceIp" ToolTip="Copy IP and device details"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Open Ports Sub-Grid -->
                        <GroupBox Header="OPEN PORTS &amp; SERVICES" Foreground="{StaticResource Magenta}" BorderBrush="{StaticResource Line}">
                            <DataGrid x:Name="DevicePortsGrid" ItemsSource="{Binding SelectedDevicePorts}" Margin="4" AutoGenerateColumns="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Port, Mode=OneWay}" Width="55">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="PORT" ToolTip="TCP/UDP port number"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Protocol, Mode=OneWay}" Width="55">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="PROTO" ToolTip="Transport protocol (TCP/UDP)"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding ServiceName, Mode=OneWay}" Width="120">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="SERVICE" ToolTip="Known application layer protocol (HTTP, DNS, SSH, etc.)"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Banner, Mode=OneWay}" Width="*">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="DETAILS / BANNER" ToolTip="Service response or handshake banner captured from the listening port"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Packet Inspector & Protocol Dissector view -->
        <Grid x:Name="PacketsPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Description -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" DockPanel.Dock="Left"
                           Text="Native Windows Packet Inspector &amp; Protocol Dissector. Dissects TLS SNI hostnames, DNS queries, plaintext HTTP, and TCP/UDP streams in real time. Zero third-party drivers or external dependencies. 100% compatible with Wireshark PCAPNG export."/>
            </DockPanel>

            <!-- Toolbar & Controls -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button x:Name="StartCaptureButton" Content="▶ Start Capture" Padding="14,3" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Click="OnStartCapture"/>
                    <Button x:Name="StopCaptureButton" Content="⏹ Stop" Padding="12,3" Margin="0,0,12,0" IsEnabled="False" Click="OnStopCapture"/>

                    <TextBlock Text="Interface:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CaptureInterfaceCombo" Width="170" VerticalAlignment="Center" Margin="0,0,12,0" SelectionChanged="OnCaptureInterfaceChanged"/>

                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PacketProtocolFilterCombo" Width="110" VerticalAlignment="Center" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="OnPacketFilterChanged">
                        <ComboBoxItem Content="All Traffic"/>
                        <ComboBoxItem Content="TLS (HTTPS)"/>
                        <ComboBoxItem Content="DNS"/>
                        <ComboBoxItem Content="HTTP"/>
                        <ComboBoxItem Content="TCP"/>
                        <ComboBoxItem Content="UDP"/>
                    </ComboBox>

                    <TextBox x:Name="PacketSearchBox" Width="160" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Search by host, IP, port, process, or keywords" TextChanged="OnPacketSearchChanged"/>
                    <Button Content="Clear Buffer" Padding="10,3" Margin="0,0,12,0" Click="OnClearPackets" ToolTip="Clear packet ring buffer"/>

                    <TextBlock x:Name="PacketStatsText" Text="Buffer: 0 / 10,000 | 0.0 pkt/s" VerticalAlignment="Center" Foreground="{StaticResource Amber}" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="💾 Export .pcapng" Padding="12,3" Margin="0,0,8,0" Foreground="{StaticResource Cyan}" FontWeight="SemiBold" Click="OnExportPcapng" ToolTip="Export captured packets to standard Wireshark PCAPNG file"/>
                    <Button Content="Export CSV" Padding="12,3" Click="OnExportPacketsCsv" ToolTip="Export packet table to CSV"/>
                </StackPanel>
            </DockPanel>

            <!-- Splitter: Packets List (Top) vs Packet Hex & Dissected Inspector (Bottom) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="2*" MinHeight="180"/>
                </Grid.RowDefinitions>

                <!-- Top: Packets DataGrid -->
                <DataGrid x:Name="PacketsGrid" Grid.Row="0" ItemsSource="{Binding CapturedPacketsView}" SelectionMode="Single"
                          SelectionChanged="OnPacketsGridSelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                            <Separator/>
                            <MenuItem Header="📋 Copy Host / SNI" Click="OnCopyPacketHost"/>
                            <MenuItem Header="📋 Copy Source IP:Port" Click="OnCopyPacketSource"/>
                            <MenuItem Header="📋 Copy Destination IP:Port" Click="OnCopyPacketDestination"/>
                            <Separator/>
                            <MenuItem Header="🛡️ Block Host in DNS" Click="OnBlockPacketHostInDns"/>
                            <MenuItem Header="🧱 Block Remote IP in Firewall" Click="OnBlockPacketRemoteInFirewall"/>
                            <Separator/>
                            <MenuItem Header="💾 Export Selected Packets to .pcapng..." Click="OnExportPcapng"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id, Mode=OneWay}" Width="60"/>
                        <DataGridTextColumn Header="TIME" Binding="{Binding TimestampDisplay, Mode=OneWay}" Width="85"/>
                        <DataGridTextColumn Header="DIR" Binding="{Binding DirectionDisplay, Mode=OneWay}" Width="65"/>
                        <DataGridTextColumn Header="PROTO" Binding="{Binding ProtocolDisplay, Mode=OneWay}" Width="75"/>
                        <DataGridTextColumn Header="HOST / SNI" Binding="{Binding HostOrSni, Mode=OneWay}" Width="210"/>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessDisplay, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="SOURCE" Binding="{Binding SourceEndpointDisplay, Mode=OneWay}" Width="180"/>
                        <DataGridTextColumn Header="DESTINATION" Binding="{Binding DestinationEndpointDisplay, Mode=OneWay}" Width="180"/>
                        <DataGridTextColumn Header="LEN" Binding="{Binding TotalLength, Mode=OneWay}" Width="60"/>
                        <DataGridTextColumn Header="FLAGS" Binding="{Binding TcpFlags, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="INFO" Binding="{Binding Info, Mode=OneWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Bottom: Dissected Packet Details & Hex Stream Viewer -->
                <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Dissected Protocol Hierarchy -->
                        <DockPanel Grid.Column="0">
                            <TextBlock Text="PROTOCOLS &amp; HEADERS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Cyan}" Margin="0,0,0,6" DockPanel.Dock="Top"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="PacketInspectorDetailsText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                           Text="Select a packet in the table above to view dissected protocol headers and decoded metadata."/>
                            </ScrollViewer>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Right Column: Hex Stream Dump -->
                        <DockPanel Grid.Column="2">
                            <TextBlock Text="HEX STREAM / PAYLOAD DUMP" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Amber}" Margin="0,0,0,6" DockPanel.Dock="Top"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="PacketHexBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"
                                         Background="#141923" BorderThickness="0" TextWrapping="NoWrap"
                                         Text="Hex stream preview will appear here."/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Rules view: every stored decision, whether or not the program is running -->
        <Grid x:Name="RulesPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Every decision you made, even for programs that are not running right now. FIREWALL shows whether Windows Firewall really contains the matching block rules (MISSING = the rules were removed outside SpectraNetworkManager)."/>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <!-- Missing Firewall Rules Warning Banner -->
                <Border x:Name="MissingRulesBanner" Visibility="Collapsed"
                        Background="#2A1B24" BorderBrush="{StaticResource Magenta}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FixRulesButton" Content="⚡ Fix / Reapply Rules" Click="OnFixMissingRules"
                                    Foreground="{StaticResource Magenta}" FontWeight="SemiBold" Padding="12,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MissingRulesBannerText"
                                       Text="Attention: Block rules are missing from Windows Firewall and currently inactive!"
                                       Foreground="{StaticResource Magenta}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                <Button x:Name="RulesRefreshButton" Content="Refresh" Margin="0,0,8,0" Click="OnRefreshRules"/>
                <Button x:Name="RulesEditButton" Content="Edit block..." Margin="0,0,8,0" Click="OnRulesEdit"
                        ToolTip="Change direction, ports or addresses of the selected block (or turn an Allow into a block)."/>
                <Button x:Name="RulesAllowButton" Content="Allow" Margin="0,0,8,0" Click="OnRulesAllow"
                        ToolTip="Switch the selected decision to Allow (removes the block)."/>
                <Button x:Name="RulesViewQuarantineButton" Content="🛡️ View Quarantine Vault" Margin="0,0,8,0" Click="OnRulesViewQuarantine" Foreground="{StaticResource Cyan}"
                        ToolTip="View and manage quarantined applications in the dedicated Quarantine Vault."/>
                <Button x:Name="RulesForgetButton" Content="Forget decision" Margin="0,0,8,0" Click="OnRulesForget"
                        ToolTip="Remove the selected decision and its firewall rules."/>
                <Button x:Name="RulesPanicButton" Content="PANIC: undo all SpectraNetworkManager changes" Click="OnPanic" Foreground="{StaticResource Magenta}"/>
            </StackPanel>
            </StackPanel>
            <DataGrid x:Name="RulesGrid" Grid.Row="2" ItemsSource="{Binding RuleRows}" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                        <Separator/>
                        <MenuItem Header="Edit block..." Click="OnRulesEdit"/>
                        <MenuItem Header="Allow" Click="OnRulesAllow"/>
                        <MenuItem Header="Forget decision" Click="OnRulesForget"/>
                        <Separator/>
                        <MenuItem Header="🔄 Restore from Quarantine..." Click="OnRestoreSelectedQuarantine" Foreground="{StaticResource MenuBlue}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROGRAM" Binding="{Binding Name, Mode=OneWay}" Width="220"/>
                    <DataGridTextColumn Header="DECISION" Binding="{Binding Decision, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="TRAFFIC" Binding="{Binding Direction, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="BLOCKS" Binding="{Binding Scope, Mode=OneWay}" Width="260"/>
                    <DataGridTextColumn Header="FIREWALL" Binding="{Binding Firewall, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="SINCE" Binding="{Binding Since, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,8">
                <TextBlock Text="TRUSTED PUBLISHERS" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="UntrustButton" Content="Remove trust" Click="OnUntrustPublisher"/>
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted}"
                           Text="Programs with a verified signature from these publishers are not asked about. Your own Block decisions still win."/>
            </StackPanel>
            <DataGrid x:Name="PublishersGrid" Grid.Row="4" ItemsSource="{Binding Publishers}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Active Defense Quarantine Vault view -->
        <Grid x:Name="QuarantinePanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Description -->
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Active Defense Quarantine Vault. Neutralized programs are safely isolated across 5 defense layers: process &amp; network socket termination, kernel-level execution lockout (IFEO), Windows Service disabling, auto-start neutralization, and bidirectional Windows Firewall blocks. 100% reversible with 1-click restore."/>

            <!-- Toolbar & Controls -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button x:Name="QuarantineRefreshButton" Content="🔄 Refresh Vault" Padding="12,3" Margin="0,0,8,0" Click="OnRefreshQuarantineVault"/>
                    <Button x:Name="QuarantineRestoreButton" Content="🔄 Restore Program (Un-Quarantine)" Padding="12,3" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Click="OnRestoreQuarantineFromVault" ToolTip="Reverses all 5 quarantine stages and completely restores the selected program"/>
                    <Button x:Name="QuarantineBrowseButton" Content="🛡️ Quarantine New File..." Padding="12,3" Margin="0,0,8,0" Click="OnQuarantineBrowseFile" ToolTip="Browse for an executable to quarantine immediately"/>
                    <Button x:Name="QuarantineAiButton" Content="🔍 Investigate with AI" Padding="12,3" Margin="0,0,8,0" Click="OnInvestigateQuarantineAi" ToolTip="Analyze the quarantined executable with Spectra AI"/>
                    <Button x:Name="QuarantineRemoveVaultButton" Content="🗑️ Remove from Vault" Padding="12,3" Margin="0,0,8,0" Click="OnDeleteQuarantineSnapshot" ToolTip="Removes this record from the vault history"/>
                    <CheckBox x:Name="QuarantineShowRestoredCheck" Content="Show Restored History" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}" Checked="OnQuarantineShowRestoredChanged" Unchecked="OnQuarantineShowRestoredChanged" ToolTip="Toggle between active quarantined programs only and full vault history"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock x:Name="QuarantineCountText" Text="0 programs quarantined" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <Button x:Name="QuarantinePanicButton" Content="PANIC: Restore All Quarantined" Padding="12,3" Foreground="{StaticResource Magenta}" Click="OnPanicRestoreAllQuarantine" ToolTip="Immediately un-quarantine all programs and restore original system state"/>
                </StackPanel>
            </DockPanel>

            <!-- Splitter: Quarantined Items Grid (Left) vs Snapshot Details (Right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Quarantined Items Grid -->
                <DataGrid x:Name="QuarantineGrid" Grid.Column="0" ItemsSource="{Binding QuarantinedItems}" SelectionMode="Single"
                          SelectionChanged="OnQuarantineGridSelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔄 Restore Program (Un-Quarantine)" Click="OnRestoreQuarantineFromVault"/>
                            <MenuItem Header="🔍 Investigate with Spectra AI" Click="OnInvestigateQuarantineAi"/>
                            <Separator/>
                            <MenuItem Header="📋 Copy Executable Path" Click="OnCopyQuarantinePath"/>
                            <MenuItem Header="📁 Open File Location" Click="OnOpenQuarantineFolder"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Remove Record from Vault" Click="OnDeleteQuarantineSnapshot"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PROGRAM" Binding="{Binding ProgramName, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay, Mode=OneWay}" Width="140"/>
                        <DataGridTextColumn Header="EXECUTION LOCK" Binding="{Binding ExecutionLockDisplay, Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="FIREWALL" Binding="{Binding FirewallDisplay, Mode=OneWay}" Width="140"/>
                        <DataGridTextColumn Header="QUARANTINED AT" Binding="{Binding QuarantinedAtDisplay, Mode=OneWay}" Width="130"/>
                        <DataGridTextColumn Header="SUMMARY" Binding="{Binding SummaryDisplay, Mode=OneWay}" Width="200"/>
                        <DataGridTextColumn Header="PATH" Binding="{Binding ExecutablePath, Mode=OneWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- Right: Snapshot Details Card -->
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Border x:Name="QuarantineStatusBadge" DockPanel.Dock="Right" CornerRadius="3" Padding="6,2" Background="#33FF2BD6">
                                    <TextBlock x:Name="QuarantineStatusBadgeText" Text="QUARANTINED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                                </Border>
                                <TextBlock Text="QUARANTINE VAULT INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" FontFamily="Bahnschrift"/>
                            </DockPanel>

                            <TextBlock x:Name="QuarantineDetailNameText" Text="Select a quarantined program" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="QuarantineDetailReasonText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Executable Path:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="QuarantineDetailPathText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                    <TextBlock Text="Quarantined On:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="QuarantineDetailTimestampText" FontSize="11" Foreground="{StaticResource Text}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Vault Snapshot ID:" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="QuarantineDetailIdText" FontSize="10" FontFamily="Consolas, monospace" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="QuarantineDetailRestoreButton" Content="🔄 Restore Program" Margin="0,0,6,4" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Click="OnRestoreQuarantineFromVault" ToolTip="Reverse all 5 quarantine stages for this program"/>
                                <Button Content="🔍 Investigate (AI)" Margin="0,0,6,4" Click="OnInvestigateQuarantineAi" ToolTip="Run Spectra AI Threat Intelligence on this executable"/>
                                <Button Content="📁 Open Folder" Margin="0,0,6,4" Click="OnOpenQuarantineFolder" ToolTip="Open the directory containing this executable"/>
                                <Button Content="🗑️ Remove from Vault" Margin="0,0,6,4" Click="OnDeleteQuarantineSnapshot" ToolTip="Removes this record from the vault history"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Breakdown GroupBox -->
                        <GroupBox Header="ISOLATION BREAKDOWN (5-STAGE ACTIVE DEFENSE)" Foreground="{StaticResource Cyan}" BorderBrush="{StaticResource Line}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <TextBlock Text="STAGE 1: PROCESS &amp; SOCKET TERMINATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="QuarantineStage1Text" Text="-- PIDs killed, -- sockets closed" FontSize="11" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>

                                    <TextBlock Text="STAGE 2: EXECUTION LOCKOUT (IFEO)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="QuarantineStage2Text" Text="-- Execution lockout status" FontSize="11" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>

                                    <TextBlock Text="STAGE 3: WINDOWS SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="QuarantineStage3Text" Text="-- Windows services stopped &amp; disabled" FontSize="11" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>

                                    <TextBlock Text="STAGE 4: AUTO-START ENTRIES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="QuarantineStage4Text" Text="-- Startup items disabled" FontSize="11" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>

                                    <TextBlock Text="STAGE 5: WINDOWS FIREWALL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="QuarantineStage5Text" Text="-- Inbound &amp; Outbound Block rules" FontSize="11" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Strict mode view -->
        <Grid x:Name="StrictPanel" Grid.Row="3" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                    <TextBlock x:Name="StrictStatus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Amber}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Strict mode switches Windows Firewall's default for outgoing connections to BLOCK. Only programs with an allow rule can connect out: your own Allow decisions, programs from publishers you trust, and a short list of Windows basics. Everything else is blocked and shows up in the Ask bar so you can decide."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="StrictEnableButton" Content="Enable strict mode..." Click="OnStrictEnable"
                                Margin="0,0,10,0" Foreground="{StaticResource Magenta}"/>
                        <Button x:Name="StrictDisableButton" Content="Turn off strict mode" Click="OnStrictDisable" Margin="0,0,10,0"/>
                        <Button x:Name="AuditButton" Content="Enable blocked-connection auditing" Click="OnEnableAudit"
                                ToolTip="Lets Windows record blocked connections in the Security log (needed for the Firewall blocks view and for strict mode prompts)."/>
                    </StackPanel>

                    <TextBlock Text="ALWAYS ALLOWED IN STRICT MODE" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Windows' built-in Core Networking rules (DHCP, DNS, IPv6) stay as they are. SpectraNetworkManager adds: the Windows kernel (System), svchost.exe (hosts most Windows services such as Windows Update, time sync and the DNS client), lsass.exe (sign-in), the Windows Defender services, and SpectraNetworkManager itself."/>

                    <TextBlock Text="GOOD TO KNOW" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- A program's first attempt fails: SpectraNetworkManager can only ask after the connection was blocked. Allow it and retry."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- Allow rules are per exe file. When a program updates into a new folder (browsers often do), it is asked about again unless its publisher is trusted."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- Microsoft Store apps and some Windows components may behave differently. If one stops working, check the Ask bar."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="- Incoming connections are not changed: Windows already blocks them by default."/>

                    <TextBlock Text="IF YOU GET LOCKED OUT" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Start SpectraNetworkManager as Administrator and press PANIC. Or, in an administrator command prompt:"/>
                    <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Text="netsh advfirewall set allprofiles firewallpolicy blockinbound,allowoutbound"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- DNS sinkhole view -->
        <Grid x:Name="DnsPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- Hosts File Tamper Warning Banner -->
                <Border x:Name="HostsTamperBanner" Visibility="Collapsed"
                        Background="#2A1B24" BorderBrush="{StaticResource Magenta}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RestoreHostsButton" Content="⚡ Restore Clean Default Hosts" Click="OnRestoreDefaultHosts"
                                    Foreground="{StaticResource Magenta}" FontWeight="SemiBold" Padding="12,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HostsTamperBannerText"
                                       Text="Attention: Windows hosts file has been modified with potential redirects!"
                                       Foreground="{StaticResource Magenta}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="DnsStatus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DnsCounters" Margin="0,4,0,0" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Cyan}" Cursor="Help">
                    <TextBlock.ToolTip>
                        <ToolTip Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" Padding="12,10">
                            <StackPanel MaxWidth="480">
                                <TextBlock Text="DNS SINKHOLE METRICS GUIDE" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,8" FontSize="12"/>
                                <TextBlock Text="• Queries: Total DNS lookup requests received by SpectraNetworkManager." Foreground="{StaticResource Text}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Blocked: Intercepted ad/tracking/telemetry domains matching blocklists or custom rules (sinkholed to 0.0.0.0 or NXDOMAIN)." Foreground="{StaticResource Magenta}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="• Cached: Queries answered instantly from local memory cache (0 ms latency, no internet lookup needed)." Foreground="{StaticResource Cyan}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="• Forwarded: Safe queries forwarded to configured upstream DNS servers (e.g. Cloudflare, Quad9)." Foreground="{StaticResource Text}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="• Failed: Queries where all upstream resolvers timed out, dropped packets, or returned DNS server errors (SERVFAIL)." Foreground="{StaticResource Amber}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="• Domains on lists: Unique malicious and tracking hostnames actively loaded into block memory." Foreground="{StaticResource Muted}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="• Cache: Total domain response sets currently active in local memory cache." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock x:Name="DnsNotes" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                <WrapPanel Margin="0,0,0,4">
                    <Button x:Name="DnsStartButton" Content="Start DNS server" Click="OnDnsStart" Margin="0,0,8,6" Foreground="{StaticResource Cyan}"/>
                    <Button x:Name="DnsStopButton" Content="Stop" Click="OnDnsStop" Margin="0,0,8,6"/>
                    <Button x:Name="DnsPauseButton" Content="Pause blocking" Click="OnDnsPauseClick" Margin="0,0,8,6"
                            ToolTip="Temporarily disable blocking for 5, 15, or 30 minutes (like Pi-hole)."/>
                    <Button x:Name="DnsTestButton" Content="Test my DNS server" Click="OnDnsSelfTest" Margin="0,0,8,6"
                            ToolTip="Sends a real query for example.com and for a blocked name to the running server, on its own port."/>
                    <Button Content="Update block lists" Click="OnDnsUpdateLists" Margin="0,0,8,6"
                            ToolTip="Downloads the lists in the settings (needs internet; with strict mode on, SpectraNetworkManager itself is allowed)."/>
                    <Button Content="Flush cache" Click="OnDnsFlush" Margin="0,0,8,6"/>
                    <Button Content="Clear log" Click="OnDnsClearLog" Margin="0,0,8,6"
                            ToolTip="Clears the displayed query log, memory counters, and database history."/>
                    <Button Content="Export CSV" Click="OnDnsExportCsv" Margin="0,0,8,6"
                            ToolTip="Export persistent SQLite query history to a CSV file."/>
                    <Button x:Name="DnsCustomRulesButton" Content="🛡️ Custom Rules (0)" Click="OnOpenCustomRulesWindow" Margin="0,0,8,6"
                            Foreground="{StaticResource Cyan}" ToolTip="View, search, add, or remove domains you have personally blocked or whitelisted."/>
                </WrapPanel>

                <WrapPanel>
                    <Grid Width="280" Margin="0,0,8,6" VerticalAlignment="Center">
                        <TextBox x:Name="DnsCheckBox" VerticalContentAlignment="Center" TextChanged="OnDnsFilterChanged"
                                 ToolTip="Type to filter the DNS log by caller program, domain, IP, type, or result (or click 'Check blocklist' to test a domain)."/>
                        <TextBlock Text="Search DNS log (program, domain, IP, type)..." IsHitTestVisible="False"
                                   Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DnsCheckBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Clear" Click="OnClearDnsSearch" Margin="0,0,8,6"
                            ToolTip="Clear the DNS log search filter"/>
                    <Button Content="Check blocklist" Click="OnDnsCheck" Margin="0,0,10,6"
                            ToolTip="Test whether the domain typed in the search box is on any blocklist, without sending a network query."/>
                    <TextBlock x:Name="DnsCheckResult" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="{StaticResource Text}"/>
                    <Button x:Name="DnsToggleSidebarButton" Content="◀ Hide Sidebar" Click="OnToggleDnsSidebar" Margin="0,0,8,6"
                            ToolTip="Collapse or expand the Settings and Adapters sidebar"/>
                </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DnsSplitterCol" Width="10"/>
                    <ColumnDefinition x:Name="DnsSidebarCol" Width="390"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DnsGrid" Grid.Row="0" ItemsSource="{Binding DnsRows}" SelectionMode="Single" PreviewMouseLeftButtonDown="OnDnsGridPreviewMouseLeftButtonDown"
                              SelectionChanged="OnDnsGridSelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🚫 Always Block Domain" Click="OnDnsContextMenuBlock" Foreground="{StaticResource Magenta}"/>
                                <MenuItem Header="🛡️ Always Allow Domain" Click="OnDnsContextMenuAllow" Foreground="{StaticResource MenuBlue}"/>
                                <Separator/>
                                <MenuItem Header="🔎 WHOIS Lookup" Click="OnDnsContextMenuWhois"/>
                                <MenuItem Header="🌐 Search Online (VirusTotal)" Click="OnDnsContextMenuLookup"/>
                                <MenuItem Header="📋 Copy Domain" Click="OnDnsContextMenuCopy"/>
                                <Separator/>
                                <MenuItem Header="🛡️ Manage Custom Rules..." Click="OnOpenCustomRulesWindow"/>
                                <MenuItem Header="🗑️ Clear DNS Log" Click="OnDnsClearLog"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Time, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="NIC / IP" Binding="{Binding Client, Mode=OneWay}" Width="95"/>
                            <DataGridTextColumn Header="CALLER PROGRAM" Binding="{Binding CallerProgram, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain, Mode=OneWay}" Width="260"/>
                            <DataGridTemplateColumn Header="TYPE" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Mode=OneWay}" ToolTip="{Binding TypeToolTip, Mode=OneWay}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RESULT" Binding="{Binding Result, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="MS" Binding="{Binding Ms, Mode=OneWay}" Width="55"/>
                            <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- DOMAIN INSPECTOR / INTELLIGENCE PANEL (FROM -> TO FLOW) -->
                    <Border x:Name="DnsInspectorPanel" Grid.Row="1" Visibility="Collapsed"
                            Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="14,10">
                        <StackPanel>
                            <!-- Top bar with Close button -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseDnsInspector"
                                        Padding="0" Width="28" Height="24"
                                        Background="#1A2140" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="12"
                                        Cursor="Hand" ToolTip="Close details panel"
                                        VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="QUERY FLOW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Magenta}" FontFamily="Bahnschrift"/>
                                    <TextBlock Text="  //  Origin (Caller / Client) ➔ Destination (Target Domain)" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Two Column Flow: FROM (Left) ➔ TO (Right) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT CARD: FROM (Caller / Client Origin) -->
                                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="FROM (CALLER / CLIENT)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Caller Program:" FontSize="11" Foreground="{StaticResource Muted}" Width="95"/>
                                            <TextBlock x:Name="InspectorInitiator" FontSize="11" Foreground="{StaticResource Cyan}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="NIC / Client IP:" FontSize="11" Foreground="{StaticResource Muted}" Width="95"/>
                                            <TextBlock x:Name="InspectorClient" FontSize="11" Foreground="{StaticResource Text}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="Query Type:" FontSize="11" Foreground="{StaticResource Muted}" Width="95"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="InspectorQueryType" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Amber}" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="InspectorQueryTypeDesc" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- MIDDLE DIRECTIONAL ARROW -->
                                <TextBlock Grid.Column="1" Text="➔" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                                           VerticalAlignment="Center" Margin="10,0"/>

                                <!-- RIGHT CARD: TO (Destination / Target Domain) -->
                                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="InspectorCategoryBadge" CornerRadius="3" Padding="6,2" Margin="4,0,0,0" Background="#2222E8FF">
                                                    <TextBlock x:Name="InspectorCategoryText" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                                </Border>
                                                <Border x:Name="InspectorAdviceBadge" CornerRadius="3" Padding="6,2" Margin="4,0,0,0" Background="#22FF2BD6">
                                                    <TextBlock x:Name="InspectorAdviceBadgeText" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="TO (TARGET DOMAIN)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="InspectorDomainText" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="Service / Org:" FontSize="11" Foreground="{StaticResource Muted}" Width="85"/>
                                            <TextBlock x:Name="InspectorServiceName" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="Root Domain:" FontSize="11" Foreground="{StaticResource Muted}" Width="85"/>
                                            <TextBlock x:Name="InspectorRootDomain" FontSize="11" Foreground="{StaticResource Text}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="InspectorDescription" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Advice & Status summary bar -->
                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="Status: " FontSize="11" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorOutcome" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Latency: " FontSize="11" Foreground="{StaticResource Muted}"/>
                                        <TextBlock x:Name="InspectorLatency" FontSize="11" Foreground="{StaticResource Text}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="InspectorAdviceTitle" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Magenta}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="InspectorAdviceDetail" FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <WrapPanel>
                                <Button x:Name="InspectorBlockButton" Content="🚫 Always Block" Click="OnInspectorBlock" Margin="0,0,8,0" Foreground="{StaticResource Magenta}"
                                        ToolTip="Adds domain to block list and immediately blocks it."/>
                                <Button x:Name="InspectorAllowButton" Content="🛡️ Always Allow" Click="OnInspectorAllow" Margin="0,0,8,0" Foreground="{StaticResource Cyan}"
                                        ToolTip="Adds domain to allow list and immediately unblocks it."/>
                                <Button x:Name="InspectorRemoveCustomButton" Content="✕ Remove Custom Rule (Undo)" Click="OnInspectorRemoveCustom" Margin="0,0,8,0" Foreground="{StaticResource Amber}" Visibility="Collapsed"
                                        ToolTip="Removes this domain from your custom list and restores default filtering."/>
                                <Button Content="🛡️ All Custom Rules..." Click="OnOpenCustomRulesWindow" Margin="0,0,8,0"
                                        ToolTip="Open Custom Rules &amp; Blocklist Manager"/>
                                <Button Content="🔎 WHOIS Lookup" Click="OnInspectorWhois" Margin="0,0,8,0" Foreground="{StaticResource Cyan}"
                                        ToolTip="Lookup domain registration, owner organization, and nameservers."/>
                                <Button Content="🌐 Search Online (VirusTotal)" Click="OnInspectorLookup" Margin="0,0,8,0"
                                        ToolTip="Opens VirusTotal threat analysis in default web browser."/>
                                <Button Content="📋 Copy Domain" Click="OnInspectorCopy" Margin="0,0,8,0"
                                        ToolTip="Copies domain to clipboard."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DnsSidebarBorder" Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10,14,14">
                            <TextBlock Text="POINT THIS PC TO SPECTRANETWORKMANAGER" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="One click points your network adapters to SpectraNetworkManager (127.0.0.1 / ::1) to block ads and trackers across your entire PC. Backs up your existing DNS first, with an automatic 60-second rollback if unconfirmed."/>

                            <!-- Status banner -->
                            <Border x:Name="DnsSwitchBanner" Background="{StaticResource Panel}" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DnsSwitchStatus" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DnsSwitchDetails" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox x:Name="DnsShowVirtualAdaptersBox" DockPanel.Dock="Right" Content="Show virtual / VPN" FontSize="11"
                                          Checked="OnDnsRefreshAdapters" Unchecked="OnDnsRefreshAdapters"
                                          ToolTip="Also show virtual switches (Hyper-V, VMware, VirtualBox) and VPN tunnel adapters."/>
                                <TextBlock Text="Select network adapters to point at SpectraNetworkManager:" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="DnsAdaptersList" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2,0,2">
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="DnsNoAdaptersHint" Text="No active Ethernet or Wi-Fi adapters detected. Tick 'Show virtual / VPN' or click 'Refresh adapters'."
                                       Foreground="{StaticResource Amber}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

                            <CheckBox x:Name="DnsFallbackModeBox" Content="Fallback mode (keep previous DNS as secondary backup)" IsChecked="False" Margin="0,0,0,8" Checked="OnFallbackModeChanged" Unchecked="OnFallbackModeChanged"
                                      ToolTip="Recommended. If SpectraNetworkManager is stopped, your computer can still reach your previous DNS servers."/>

                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="DnsApplySwitchButton" Content="Point PC to SpectraNetworkManager..." Click="OnDnsSwitchApply" Margin="0,0,8,6" Foreground="{StaticResource Cyan}"/>
                                <Button x:Name="DnsRestoreSwitchButton" Content="Restore original DNS" Click="OnDnsSwitchRestore" Margin="0,0,8,6"/>
                                <Button Content="Refresh adapters" Click="OnDnsRefreshAdapters" Margin="0,0,8,6"/>
                            </WrapPanel>

                            <TextBlock Text="BROWSER SECURE DNS (DoH) NOTICE" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Browsers (Chrome, Edge) sometimes bypass Windows DNS with built-in DNS-over-HTTPS. In Chrome/Edge settings under Privacy &amp; Security -> Use secure DNS, select 'With your current service provider' (or disable it)."/>

                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                            <TextBlock Text="SETTINGS" FontWeight="SemiBold" Foreground="{StaticResource Magenta}" Margin="0,0,0,8"/>

                            <TextBlock Text="Listen address" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsListenBox" Margin="0,2,0,2"
                                     ToolTip="127.0.0.1 = only this PC. 0.0.0.0 = also other devices on your network."/>
                            <TextBlock Text="127.0.0.1 = only this PC.  0.0.0.0 = also your network." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>

                            <TextBlock Text="Port" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsPortBox" Margin="0,2,0,2"/>
                            <TextBlock Text="53 is the normal DNS port. If it is taken, try 5353 and use 'Test my DNS server' (Windows' nslookup only talks to port 53)." FontSize="11"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Upstream DNS servers (answer what is not blocked)" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsUpstreamsBox" Margin="0,2,0,4"
                                     ToolTip="IP addresses (9.9.9.9), DoH URLs (https://9.9.9.9/dns-query), or DoT (tls://9.9.9.9:853)."/>

                            <!-- Upstream Presets -->
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="Presets:" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="Quad9 DoH" Click="OnPresetQuad9Doh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Cloudflare DoH" Click="OnPresetCloudflareDoh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Google DoH" Click="OnPresetGoogleDoh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Quad9 DoT" Click="OnPresetQuad9Dot" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Standard" Click="OnPresetStandard" FontSize="10" Padding="4,1" Margin="0,0,0,2"/>
                            </WrapPanel>
                            <TextBlock x:Name="DnsUpstreamStatusText" FontSize="10" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Blocked names get" Foreground="{StaticResource Muted}"/>
                            <RadioButton x:Name="DnsNullRadio" Content="0.0.0.0 / :: (fast, programs fail at once)" GroupName="blockmode" Margin="0,4,0,2"/>
                            <RadioButton x:Name="DnsNxRadio" Content="'does not exist' (NXDOMAIN)" GroupName="blockmode" Margin="0,2,0,8"/>

                            <CheckBox x:Name="InspectCnameBox" Content="Also block names that are only an alias of a blocked name" Margin="0,2,0,2"/>
                            <CheckBox x:Name="BlockDohBox" Content="Tell Firefox not to bypass this DNS (its DoH check)" Margin="0,2,0,2"/>
                            <CheckBox x:Name="BrowserDohGuardBox" Content="🛡️ Force Chrome, Edge, Brave &amp; Firefox to use this DNS (Disable DoH bypass)" Margin="0,2,0,4"
                                      Checked="OnBrowserDohGuardChanged" Unchecked="OnBrowserDohGuardChanged"
                                      ToolTip="Enforces Windows Group Policies so web browsers cannot bypass local DNS or blocklists using internal encrypted DNS-over-HTTPS."/>

                            <!-- Hosts File Guard Status Card -->
                            <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,4,0,6">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="⚡ Restore Clean Template" Click="OnRestoreDefaultHosts" Padding="8,2" FontSize="10" ToolTip="Reset Windows hosts file to official Microsoft default"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HostsFileStatusBadge" Text="🟢 Hosts File Guard: Clean (No suspicious redirects detected)" FontSize="11" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <CheckBox x:Name="AutoStartDnsBox" Content="Start the DNS server when SpectraNetworkManager starts" Margin="0,2,0,4" Checked="OnAutoStartDnsChanged" Unchecked="OnAutoStartDnsChanged"/>
                            <CheckBox x:Name="RestrictClientsBox" Content="Only answer queries from local / private networks" Margin="0,2,0,4"
                                      ToolTip="Protects your PC from acting as an open resolver on the internet if listening on 0.0.0.0."/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock Text="Rate limit:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBox x:Name="DnsRateLimitBox" Width="50" VerticalContentAlignment="Center"
                                         ToolTip="Maximum queries per second per client IP (0 = unlimited). Mitigates DNS amplification floods."/>
                                <TextBlock Text="queries / sec per IP" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="LOG PRIVACY &amp; RETENTION" FontWeight="SemiBold" Foreground="{StaticResource Magenta}" FontSize="10" Margin="0,4,0,4"/>
                            <CheckBox x:Name="AnonymizeIpsBox" Content="Anonymize client IP addresses in query history" Margin="0,2,0,2"
                                      ToolTip="Masks the last octet of IPv4 and /64 of IPv6 client addresses."/>
                            <CheckBox x:Name="DoNotStoreDomainsBox" Content="Do not store domain names in history log ([redacted])" Margin="0,2,0,4"
                                      ToolTip="Prevents domain names from being recorded in the persistent SQLite database."/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                <TextBlock Text="History retention:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBox x:Name="RetentionDaysBox" Width="40" VerticalContentAlignment="Center"
                                         ToolTip="Number of days to keep query logs in the SQLite database (0 = never delete)."/>
                                <TextBlock Text="days" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="Block lists (one per line:  Name | URL;  start a line with # to switch it off)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ListsBox" Margin="0,2,0,8" Height="84" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Always block (one per line; a domain also blocks its subdomains; /regex/ allowed)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="CustomBlockBox" Margin="0,2,0,8" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Always allow (wins over every block list)" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="CustomAllowBox" Margin="0,2,0,8" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Local DNS records (domain | type | value, e.g. nas.home | A | 192.168.1.100)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="LocalRecordsBox" Margin="0,2,0,8" Height="50" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     ToolTip="Authoritative custom records served directly by SpectraNetworkManager without upstream lookups."/>

                            <TextBlock Text="Conditional forwarding (domain suffix | target server, e.g. lan | 192.168.1.1)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ConditionalForwardingBox" Margin="0,2,0,10" Height="50" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     ToolTip="Forwards router/LAN domains or reverse PTR zones directly to your router."/>

                            <Button Content="Save settings" Click="OnDnsSave" Foreground="{StaticResource Cyan}" HorizontalAlignment="Left" Margin="0,0,0,14"
                                    ToolTip="Saves, and restarts the DNS server if it is running."/>

                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                            <TextBlock Text="OTHER DEVICES ON YOUR NETWORK" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Set the listen address to 0.0.0.0, then allow DNS requests from your local network in Windows Firewall (only your home network, never public networks). Then point your router's DNS (or a device's DNS) at this PC."/>
                            <WrapPanel>
                                <Button Content="Allow local network" Click="OnDnsAllowLan" Margin="0,0,8,0"/>
                                <Button Content="Remove permission" Click="OnDnsRemoveLan"/>
                            </WrapPanel>

                            <TextBlock x:Name="DnsTop" Margin="0,16,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- TV & Mobile Protection Hub View -->
        <Grid x:Name="TvMobilePanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Sub-Navigation & Action Toolbar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <RadioButton x:Name="TvSubTabDevices" Content="📱 Connected Devices" GroupName="tvSubView" IsChecked="True"
                                 Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Checked="OnTvSubTabChanged"
                                 ToolTip="View detected Smart TVs, mobile phones, and their protection status"/>
                    <RadioButton x:Name="TvSubTabDiagnostics" Content="🔍 Investigation &amp; Diagnostics" GroupName="tvSubView"
                                 Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Checked="OnTvSubTabChanged"
                                 ToolTip="Diagnostics hub, LAN DNS self-test, live traffic feed, and troubleshooting why 0 queries appear"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📺 Shield All Smart TVs" Click="OnShieldAllSmartTvs" Margin="0,0,8,0" Padding="10,4"
                            Foreground="{StaticResource Cyan}" ToolTip="Apply vendor ACR viewing telemetry blocklists to all Smart TVs"/>
                    <Button Content="📱 Shield All Mobile Devices" Click="OnShieldAllMobileDevices" Margin="0,0,8,0" Padding="10,4"
                            Foreground="{StaticResource Magenta}" ToolTip="Apply mobile ad and tracking SDK blocklists to all phones"/>
                    <Button Content="📱 Launch Mobile Companion &amp; QR" Click="OnLaunchMobileCompanion" Margin="0,0,8,0" Padding="12,4"
                            Foreground="{StaticResource Amber}" ToolTip="Start the mobile HTTP companion server and show one-time QR code"/>
                    <Button Content="⚙️ DNS Setup Guide" Click="OnShowDnsSetupGuide" Margin="0,0,8,0" Padding="10,4"
                            ToolTip="Step-by-step DNS onboarding instructions for Samsung, LG, Roku, Apple TV, and Android"/>
                    <Button Content="🔄 Refresh Devices" Click="OnRefreshTvMobileDevices" Padding="10,4"/>
                </StackPanel>
            </DockPanel>

            <!-- Sub-Tab 1: Connected Devices View -->
            <Grid x:Name="TvDevicesSubPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Metrics WrapPanel -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Devices: " FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TvTotalDevicesCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Direct Protected: " FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TvDirectProtectedCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gateway Routed: " FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TvGatewayRoutedCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bypassing / Inactive: " FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="TvBypassingCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Magenta}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Banners Area -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <!-- LAN DNS Protection Status & 1-Click Activation Banner -->
                    <Border x:Name="TvLanStatusBanner" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TvEnableLanBtn" Content="🛡️ Enable LAN Protection (0.0.0.0 &amp; Firewall)" Click="OnEnableLanProtectionClick"
                                        Foreground="{StaticResource Cyan}" FontWeight="SemiBold" Padding="12,5" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TvLanStatusTitle" Text="🌐 LAN SINKHOLE STATUS: " FontWeight="Bold" FontSize="12" Foreground="{StaticResource Cyan}"/>
                                    <TextBlock x:Name="TvLanStatusSub" Text="Checking..." FontSize="12" Foreground="{StaticResource Text}"/>
                                </StackPanel>
                                <TextBlock x:Name="TvLanStatusDesc" Text="Smart TVs and phones require Spectra to listen on 0.0.0.0 and allow inbound port 53."
                                           FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Router Forwarding Notice Banner -->
                    <Border x:Name="TvGatewayNoticeBanner" Background="{StaticResource Panel}" BorderBrush="{StaticResource Amber}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="How to Fix..." Click="OnShowDnsSetupGuide" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟡 ROUTER DNS FORWARDING DETECTED" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Amber}"/>
                                    <TextBlock x:Name="TvGatewayNoticeText" Text=" (Gateway: 192.168.1.1)" FontSize="12" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <TextBlock Text="Your router forwards DNS queries on behalf of LAN devices. Global blocklists work, but per-device Smart TV &amp; GSM rules require setting Spectra's LAN IP as the DNS server in your device Wi-Fi settings."
                                           FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- TV & Mobile Devices DataGrid -->
                <DataGrid x:Name="TvMobileGrid" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnTvMobileSelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📺 Apply Smart TV ACR Shield" Click="OnContextShieldTv" Foreground="{StaticResource MenuBlue}"/>
                            <MenuItem Header="📱 Apply Mobile Ad &amp; Tracker Shield" Click="OnContextShieldMobile" Foreground="{StaticResource Magenta}"/>
                            <Separator/>
                            <MenuItem Header="⏸ Pause Protection for this Device (15m)" Click="OnContextPauseDevice"/>
                            <MenuItem Header="▶ Resume Protection" Click="OnContextResumeDevice"/>
                            <Separator/>
                            <MenuItem Header="⚙️ Show DNS Setup Steps for this Device" Click="OnContextShowGuide"/>
                            <MenuItem Header="🔎 Scan Device Ports..." Click="OnContextScanPorts"/>
                            <MenuItem Header="📋 Copy IP Address" Click="OnContextCopyIp"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding ProtectionBadge}" Width="150"/>
                        <DataGridTextColumn Header="DEVICE TYPE" Binding="{Binding DeviceTypeDisplay}" Width="130"/>
                        <DataGridTextColumn Header="HOSTNAME / NAME" Binding="{Binding Hostname}" Width="200" Foreground="{StaticResource Cyan}"/>
                        <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IpString}" Width="130"/>
                        <DataGridTextColumn Header="MAC / VENDOR" Binding="{Binding Vendor}" Width="190"/>
                        <DataGridTextColumn Header="ASSIGNED GROUP" Binding="{Binding AssignedGroup}" Width="140"/>
                        <DataGridTextColumn Header="TOTAL QUERIES" Binding="{Binding TotalQueries}" Width="110"/>
                        <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastQueryDisplay}" Width="100"/>
                        <DataGridTextColumn Header="DETAILS &amp; GUIDANCE" Binding="{Binding ProtectionDesc}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Device Quick Inspector -->
                <Border x:Name="TvDeviceInspector" Grid.Row="3" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Device Title & Action Toolbar -->
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TvInspectorPairBtn" Content="📱 Pair Phone (QR Code)" Click="OnInspectorPairMobileClick" Margin="0,0,8,0" Padding="10,4"
                                        Foreground="{StaticResource Amber}" ToolTip="Open the QR code pairing window for this phone / mobile device"/>
                                <Button x:Name="TvInspectorWebBtn" Content="🌐 Open Companion Page" Click="OnInspectorOpenWebClick" Margin="0,0,8,0" Padding="10,4"
                                        Foreground="{StaticResource Cyan}" ToolTip="Open this phone's companion dashboard in your default browser"/>
                                <Button Content="⚙️ DNS Setup Instructions" Click="OnInspectorShowGuideClick" Margin="0,0,8,0" Padding="10,4"
                                        ToolTip="View step-by-step Wi-Fi DNS setup steps for this device"/>
                                <ComboBox x:Name="TvGroupAssignCombo" Width="130" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button Content="Assign Group" Click="OnAssignGroupClick" Margin="0,0,8,0" Padding="10,3"/>
                                <Button Content="✕ Close" Click="OnCloseTvInspector" Padding="8,3"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TvInspectorNameText" Text="Selected Device" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Cyan}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TvInspectorIpText" Text="192.168.1.X" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TvInspectorGuidanceText" Text="Guidance information" FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Row 1: Live Status & Metrics Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Mobile Companion Live Telemetry -->
                            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="📱 MOBILE COMPANION STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                        <TextBlock x:Name="TvInspectorCompanionBadge" DockPanel.Dock="Right" Text="CHECKING..." FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TvInspectorCompanionDetails" Text="No web companion contact recorded yet." FontSize="11" Foreground="{StaticResource Text}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Card: Query Defense Stats -->
                            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="🛡️ DEVICE DNS TRAFFIC &amp; DEFENSE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                        <TextBlock x:Name="TvInspectorQueryRateBadge" DockPanel.Dock="Right" Text="0% BLOCKED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TvInspectorQueryStats" Text="Total Queries: 0  •  Blocked: 0  •  Allowed: 0" FontSize="11" Foreground="{StaticResource Text}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 2: Live Query Log for Selected Device -->
                        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                    <TextBlock Text="⚡ RECENT ACTIVITY FOR THIS DEVICE (Live Stream)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                                    <TextBlock x:Name="TvInspectorRecentCountText" DockPanel.Dock="Right" Text="0 queries" FontSize="10" Foreground="{StaticResource Muted}"/>
                                </DockPanel>
                                <DataGrid x:Name="TvInspectorRecentGrid" ItemsSource="{Binding TvDeviceRecentQueries}" MaxHeight="130"
                                          AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="70"/>
                                        <DataGridTextColumn Header="DOMAIN / REQUEST" Binding="{Binding Domain}" Width="250" Foreground="{StaticResource Cyan}"/>
                                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="60"/>
                                        <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="100"/>
                                        <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sub-Tab 2: Dedicated Investigation & Diagnostics Panel -->
            <Grid x:Name="TvInvestigationSubPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Live Health & Setup Checklist Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: DNS Server Status -->
                    <Border Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="1. DNS SINKHOLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                <TextBlock x:Name="InvDnsStateBadge" DockPanel.Dock="Right" Text="CHECKING..." FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            </DockPanel>
                            <TextBlock x:Name="InvDnsEndpointText" Text="0.0.0.0:53" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="InvDnsDetailText" Text="Wildcard bind active" FontSize="11" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Windows Firewall Status -->
                    <Border Grid.Column="1" Margin="0,0,6,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="2. FIREWALL (PORT 53/8765)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                <TextBlock x:Name="InvFwStateBadge" DockPanel.Dock="Right" Text="CHECKING..." FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            </DockPanel>
                            <TextBlock x:Name="InvFwTitleText" Text="LocalSubnet Allow" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="InvFwDetailText" Text="Inbound rules active" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Network Profile (Public / Private) -->
                    <Border Grid.Column="2" Margin="0,0,6,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="3. NETWORK PROFILE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                <TextBlock x:Name="InvNetStateBadge" DockPanel.Dock="Right" Text="CHECKING..." FontSize="10" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            </DockPanel>
                            <TextBlock x:Name="InvNetTitleText" Text="Private Network" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,4,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InvNetDetailText" Text="Ethernet / Cable" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button x:Name="InvFixNetBtn" Content="Fix to Private" Click="OnInvFixNetworkProfile" Visibility="Collapsed" Padding="6,1" FontSize="10" Margin="8,0,0,0" ToolTip="Switch this connection from Public to Private so Windows Firewall allows local device traffic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Mobile Companion & Phone Reachability -->
                    <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="4. PHONE REACHABILITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                                <TextBlock x:Name="InvCompanionStateBadge" DockPanel.Dock="Right" Text="READY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Magenta}"/>
                            </DockPanel>
                            <TextBlock x:Name="InvCompanionUrlText" Text=":8765 (/api/ping)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Magenta}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="InvLastContactText" Text="No remote hits yet" FontSize="11" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Interactive Diagnostics Bar -->
                <Border Grid.Row="1" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="🧪 Self-Test DNS on LAN IP" Click="OnInvRunDnsSelfTest" Margin="0,0,8,0" Padding="10,3" Foreground="{StaticResource Cyan}"
                                    ToolTip="Sends a live DNS query to this PC's local LAN IP:53 to verify the socket is bound and responding to network packets"/>
                            <Button Content="📱 Phone Setup Guide" Click="OnOpenPhoneSetupGuide" Margin="0,0,8,0" Padding="10,3" Foreground="{StaticResource Cyan}"
                                    ToolTip="Visual step-by-step instructions to configure phone Wi-Fi DNS and disable Android Private DNS / DoT bypass"/>
                            <Button Content="📋 Copy Phone Ping Link" Click="OnInvCopyPhonePingUrl" Margin="0,0,8,0" Padding="10,3" Foreground="{StaticResource Amber}"
                                    ToolTip="Copies http://[PC-IP]:8765/api/ping to clipboard. Open this on your phone's browser to test connectivity instantly"/>
                            <Button Content="📋 Copy Diagnostic Report" Click="OnInvCopyReport" Margin="0,0,8,0" Padding="10,3"
                                    ToolTip="Copies complete network diagnostic details to the clipboard for troubleshooting"/>
                            <Button Content="🔄 Refresh Status" Click="OnInvRefreshStatus" Padding="10,3"
                                    ToolTip="Re-probes Windows Firewall, network profiles, and listener state"/>
                        </StackPanel>
                        <TextBlock x:Name="InvSelfTestResultText" Text="Ready for diagnostics. Click 'Self-Test DNS on LAN IP' to verify port 53 reachability."
                                   VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- Row 2: Split View: Troubleshooting Guide (Left) vs Live LAN Traffic Feed (Right) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" MinWidth="340"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Why 0 Queries Guide -->
                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="WHY 0 QUERIES? COMMON CAUSES &amp; FIXES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,8" FontFamily="Bahnschrift"/>

                                <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="1. Android 'Private DNS' is Active" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Amber}"/>
                                        <TextBlock Text="Android devices bypass manual Wi-Fi DNS settings if 'Private DNS' (DoT) is enabled. Go to Phone Settings → Network &amp; Internet → Private DNS → Set to OFF."
                                                   FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="2. Secondary DNS (DNS 2) is Configured" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Amber}"/>
                                        <TextBlock Text="If DNS 2 has 8.8.8.8, 1.1.1.1, or router IP, your phone sends queries to both and prefers whichever answers fastest. Leave DNS 2 BLANK, or set DNS 2 to this PC's IP as well."
                                                   FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="3. Ethernet PC vs Guest Wi-Fi Isolation" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Amber}"/>
                                        <TextBlock Text="If your PC is on Ethernet cable and your phone is on a Guest Wi-Fi network, many routers enable 'Client Isolation' which blocks guest Wi-Fi devices from talking to wired LAN PCs."
                                                   FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="4. Cached DNS / Airplane Mode" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Amber}"/>
                                        <TextBlock Text="Phones cache domain resolutions. Turn Airplane Mode ON for 5 seconds and then OFF to force your phone to flush its internal DNS cache and request fresh queries."
                                                   FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                    <!-- Right: Live LAN Traffic Feed -->
                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <DockPanel LastChildFill="False" DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE LAN TRAFFIC FEED" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Magenta}" FontFamily="Bahnschrift"/>
                                    <TextBlock Text=" (Queries &amp; Pings from LAN devices)" FontSize="11" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Clear Feed" Click="OnInvClearLanFeed" Padding="8,2" FontSize="10"/>
                            </DockPanel>

                            <!-- Dynamic Android Private DNS / DoT warning banner -->
                            <Border x:Name="InvAndroidDohWarningBorder" Visibility="Collapsed" Background="#2E1800" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" DockPanel.Dock="Top">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="📱 Fix on Phone..." Click="OnOpenPhoneSetupGuide" Padding="10,2" FontSize="11" Margin="8,0,0,0" Foreground="{StaticResource Cyan}"/>
                                    <TextBlock x:Name="InvAndroidDohWarningText" Text="⚠️ Android Device Detected: Private DNS (DoT port 853) is active on your phone, bypassing the sinkhole for browser traffic."
                                               Foreground="{StaticResource Amber}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <DataGrid x:Name="TvLanFeedGrid" ItemsSource="{Binding TvLanActivityRows}" SelectionMode="Single" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="75"/>
                                    <DataGridTextColumn Header="CLIENT IP" Binding="{Binding Client}" Width="120" Foreground="{StaticResource Cyan}"/>
                                    <DataGridTextColumn Header="DOMAIN / REQUEST" Binding="{Binding Domain}" Width="190"/>
                                    <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="70"/>
                                    <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="110"/>
                                    <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Browser Guard View -->
        <Grid x:Name="BrowserGuardPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Status & Registration Banner -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BrowserRegisterHostButton" Content="🛡️ Register Native Host for Browsers" Click="OnRegisterBrowserHost" Margin="0,0,8,0" Padding="12,5"
                                Foreground="{StaticResource Cyan}" ToolTip="Registers Native Messaging Host in Windows Registry for Chrome, Edge &amp; Firefox"/>
                        <Button Content="📁 Open Extension Folder" Click="OnOpenExtensionFolder" Margin="0,0,8,0" Padding="12,5"
                                ToolTip="Opens the extension directory so you can load unpacked in chrome://extensions or about:debugging"/>
                        <Button Content="🔄 Reload Dynamic Rules" Click="OnReloadBrowserRules" Padding="10,5"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SPECTRA BROWSER GUARD (MANIFEST V3)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Cyan}"/>
                            <Border x:Name="BrowserHostStatusBadge" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Background="#2200E5FF">
                                <TextBlock x:Name="BrowserHostStatusText" Text="🟢 Host Registered in Chrome, Edge &amp; Firefox" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Enforces browser-level declarative URL patterns, YouTube Shorts suppression, and video stream blocking with zero network latency."
                                   FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Quick Shields Toggles -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="GuardBlockShortsCheck" Content="🚫 Block YouTube Shorts"
                              Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Blocks all YouTube Shorts pages and short-form video feeds"/>
                    <CheckBox x:Name="GuardBlockStreamsCheck" Content="🚫 Block Video Streams (googlevideo)"
                              Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Blocks raw video playback delivery segments (stops videos from loading)"/>
                    <CheckBox x:Name="GuardBlockAdsCheck" Content="🚫 Block In-Player Ad Beacons"
                              Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Blocks in-player YouTube ad statistics and telemetry"/>
                    <CheckBox x:Name="GuardBlockTikTokCheck" Content="🚫 Block TikTok Video Feeds"
                              Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Blocks TikTok short-form web video playback"/>
                    <CheckBox x:Name="GuardBlockReelsCheck" Content="🚫 Block Instagram Reels"
                              Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Blocks Instagram Reels video page navigation"/>
                    <CheckBox x:Name="GuardPlaceholderCheck" Content="🛡️ Show In-Page Dark Overlay on Blocked Videos"
                              VerticalAlignment="Center" Checked="OnGuardToggleChanged" Unchecked="OnGuardToggleChanged"
                              ToolTip="Replaces blocked video players with sleek cybernetic overlay and 'Allow Once' button"/>
                </WrapPanel>
            </Border>

            <!-- Custom Rule Adder Form -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="+ Add Block Rule" Click="OnAddBrowserGuardRule" Padding="14,4" Foreground="{StaticResource Magenta}" Margin="8,0,0,0"/>
                    <ComboBox x:Name="GuardResourceTypeCombo" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Resource type to intercept"/>
                    <TextBox x:Name="GuardTitleBox" DockPanel.Dock="Right" Width="180" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Friendly name / title"/>
                    <TextBox x:Name="GuardPatternBox" VerticalContentAlignment="Center" ToolTip="URL match pattern (e.g. *://*.youtube.com/shorts/* or *://*.example.com/*)"/>
                </DockPanel>
            </Border>

            <!-- Browser Guard Rules DataGrid -->
            <DataGrid x:Name="BrowserGuardGrid" Grid.Row="3" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="RULE TITLE / DESCRIPTION" Binding="{Binding Title}" Width="240" Foreground="{StaticResource Cyan}"/>
                    <DataGridTextColumn Header="URL PATTERN" Binding="{Binding Pattern}" Width="320" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="RESOURCE TYPE" Binding="{Binding ResourceType}" Width="130"/>
                    <DataGridTextColumn Header="ACTION" Binding="{Binding ActionDisplay}" Width="100"/>
                    <DataGridTemplateColumn Header="ACTIONS" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕ Remove" Click="OnRemoveBrowserRuleClick" Padding="6,1" Foreground="{StaticResource Amber}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Spectra AI Threat Intelligence & Investigation view -->
        <Grid x:Name="AiPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Target Selection & Execution Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource Selected}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AiInvestigateButton" Content="✨ Run Investigation" Padding="16,6" FontWeight="SemiBold"
                                Background="{StaticResource Cyan}" Foreground="#0D1117" Click="OnRunAiInvestigationClick"
                                ToolTip="Execute a multi-factor deterministic threat investigation and optional local Ollama analysis on the target."/>
                    </StackPanel>

                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AiSelectProcessLabel" Text="Target Process:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AiProcessCombo" Width="260" Margin="0,0,10,0" VerticalAlignment="Center"
                                  SelectionChanged="OnAiProcessSelectionChanged"/>
                        <Button x:Name="AiBrowseButton" Content="📁 Browse .exe..." Padding="10,3" Margin="0,0,14,0" Click="OnAiBrowseClick"
                                ToolTip="Select an executable on disk to investigate."/>
                        <TextBlock x:Name="AiTargetDisplay" Text="No target selected" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <CheckBox x:Name="AiAutoInvestigateCheck" Content="Auto-investigate new unverified programs"
                                  VerticalAlignment="Center" Margin="10,0,0,0" Checked="OnAiAutoInvestigateChanged" Unchecked="OnAiAutoInvestigateChanged"
                                  ToolTip="When enabled, newly detected unverified processes will automatically have a background AI evidence record generated."/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Ollama Engine & Status Banner -->
            <Border Grid.Row="1" Background="#161B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                        <TextBox x:Name="AiModelText" Text="qwen2.5:7b" Width="110" Height="22" FontFamily="Consolas" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="AiTestLlmButton" Content="🔄 Test LLM" Padding="8,2" FontSize="11" Click="OnAiTestLlmClick"
                                ToolTip="Test connection to local Ollama API (http://127.0.0.1:11434)."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AiOllamaStatusText" Text="⚪ Offline Deterministic Engine (Ollama Offline)" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AiRunningIndicator" Text="  [⏳ Investigating...]" Visibility="Collapsed" FontWeight="Bold" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Two-column main view: Left = Current Report Card, Right = Historical Investigations -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Active Investigation Card -->
                <Border Grid.Column="0" Background="{StaticResource Selected}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Badges & Score Header -->
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiRiskScoreHeader" Text="THREAT RISK SCORE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="AiRiskScoreDisplay" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AiTargetTitle" Text="Select a process or executable above" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Cyan}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border x:Name="AiVerificationBadge" Padding="8,2" CornerRadius="3" Background="#21262D" BorderBrush="{StaticResource Cyan}" BorderThickness="1" Margin="0,0,8,0">
                                            <TextBlock x:Name="AiVerificationText" Text="Identity Verification Pending" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                        </Border>
                                        <Border x:Name="AiVerdictBadge" Padding="8,2" CornerRadius="3" Background="#21262D" BorderBrush="{StaticResource Amber}" BorderThickness="1">
                                            <TextBlock x:Name="AiVerdictText" Text="Status: Unknown" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Amber}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Executive Summary Box -->
                            <TextBlock x:Name="AiSummaryHeader" Text="Executive Summary" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,4,0,2"/>
                            <Border Background="#161B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,12">
                                <TextBlock x:Name="AiSummaryText" Text="Run an investigation to view AI and deterministic telemetry assessment." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}"/>
                            </Border>

                            <!-- Action Bar -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="AiAllowButton" Content="🛡️ Allow Program" Padding="10,4" Margin="0,0,8,0" Click="OnAiAllowProgramClick" ToolTip="Add permanent Allow rule for this program."/>
                                <Button x:Name="AiBlockButton" Content="🚫 Block Outbound" Padding="10,4" Margin="0,0,8,0" Foreground="{StaticResource Magenta}" Click="OnAiBlockProgramClick" ToolTip="Add permanent Block rule for this program."/>
                                <Button x:Name="AiQuarantineButton" Content="⚠️ 5-Stage Quarantine" Padding="10,4" Margin="0,0,8,0" Foreground="{StaticResource Amber}" Click="OnAiQuarantineProgramClick" ToolTip="Execute reversible 5-stage active defense quarantine on this process."/>
                                <Button x:Name="AiVirusTotalButton" Content="🌐 VirusTotal" Padding="10,4" Margin="0,0,8,0" Click="OnAiVirusTotalClick" ToolTip="Look up SHA-256 hash on VirusTotal."/>
                                <Button x:Name="AiCopyReportButton" Content="📋 Copy JSON" Padding="10,4" Click="OnAiCopyReportClick" ToolTip="Copy complete JSON investigation report to clipboard."/>
                            </StackPanel>

                            <!-- Key Findings -->
                            <TextBlock x:Name="AiFindingsHeader" Text="Deterministic Telemetry Findings" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,4,0,2"/>
                            <Border Background="#161B22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,12">
                                <TextBlock x:Name="AiFindingsText" Text="No telemetry gathered yet." FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                            </Border>

                            <!-- Identified Capabilities -->
                            <TextBlock x:Name="AiCapabilitiesHeader" Text="Identified Capabilities &amp; Behaviors" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,4,0,2"/>
                            <WrapPanel x:Name="AiCapabilitiesPanel" Margin="0,0,0,12">
                                <TextBlock Text="None recorded" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </WrapPanel>

                            <!-- Uncertainties & Blind Spots -->
                            <TextBlock x:Name="AiUncertaintiesHeader" Text="Uncertainties &amp; Blind Spots" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amber}" Margin="0,4,0,2"/>
                            <Border Background="#1C1B14" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,4">
                                <TextBlock x:Name="AiUncertaintiesText" Text="None reported" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Amber}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Past Investigations History -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="AiClearHistoryButton" DockPanel.Dock="Right" Content="Clear History" Padding="8,2" FontSize="11" Click="OnAiClearHistoryClick"/>
                        <TextBlock x:Name="AiHistoryHeader" Text="Investigation History" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid x:Name="AiHistoryGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnAiHistorySelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding TimestampDisplay}" Width="80"/>
                            <DataGridTextColumn Header="PROCESS / TARGET" Binding="{Binding ProcessName}" Width="130" Foreground="{StaticResource Cyan}"/>
                            <DataGridTextColumn Header="VERDICT" Binding="{Binding VerdictDisplay}" Width="85"/>
                            <DataGridTextColumn Header="RISK" Binding="{Binding RiskScore}" Width="45"/>
                            <DataGridTextColumn Header="ENGINE" Binding="{Binding ModelUsed}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Firewall blocks view -->
        <Grid x:Name="BlocksPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="RefreshBlocksButton" Content="Refresh" Padding="16,4" Margin="0,0,14,0" Click="OnRefreshBlocks"/>
                <TextBlock x:Name="BlocksHint" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           Text="Shows connections Windows Firewall blocked in the last hour."/>
            </StackPanel>
            <DataGrid x:Name="BlocksGrid" Grid.Row="1" ItemsSource="{Binding Blocks}" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✨ Investigate with Spectra AI" Click="OnContextMenuInvestigateAi" FontWeight="SemiBold" Foreground="{StaticResource MenuBlue}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="DIR" Binding="{Binding Direction, Mode=OneWay}" Width="60"/>
                    <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding Application, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="Check for Updates" Padding="10,2" Margin="10,0,0,0" FontSize="11"
                    Click="OnCheckUpdatesClick"
                    ToolTip="Check for newer SpectraNetworkManager versions on GitHub Releases (Zero Telemetry)"/>
            <Button DockPanel.Dock="Right" Content="Copy Support Info" Padding="10,2" Margin="10,0,0,0" FontSize="11"
                    Foreground="{StaticResource Cyan}" Click="OnCopySupportInfo"
                    ToolTip="Copies a sanitized system and SpectraNetworkManager diagnostics report to clipboard with personal user paths redacted."/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Starting..." VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
