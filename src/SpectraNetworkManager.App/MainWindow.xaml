<Window x:Class="SpectraNetworkManager.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpectraNetworkManager" Width="1400" Height="800" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SPECTRANETWORKMANAGER" FontSize="26" FontWeight="Bold" FontFamily="Bahnschrift"
                           Foreground="{StaticResource Cyan}"/>
                <TextBlock Text="  //  live network monitor" FontSize="14" Foreground="{StaticResource Magenta}"
                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <Border x:Name="AdminStateBadge" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="3"
                        ToolTip="Current privilege mode. Click 'Switch' to change modes.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminStateIcon" Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdminStateText" Text="ADMINISTRATOR" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border x:Name="DnsBadge" Visibility="Collapsed" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="3">
                    <TextBlock Text="DNS ON" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                </Border>
                <Border x:Name="StrictBadge" Visibility="Collapsed" Margin="18,0,0,4" Padding="10,2" VerticalAlignment="Bottom"
                        Background="{StaticResource Selected}" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="3">
                    <TextBlock Text="STRICT MODE ON" FontWeight="SemiBold" Foreground="{StaticResource Amber}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SwitchElevationButton" Content="Restart in Normal Mode" Margin="0,0,10,0" Click="OnSwitchElevationClick"
                        ToolTip="Restart SpectraNetworkManager in standard user mode without Administrator privileges."/>
                <Button x:Name="UpdateBadge" Content="Update Available" Visibility="Collapsed" Margin="0,0,10,0"
                        Foreground="{StaticResource Cyan}" Click="OnUpdateBadgeClick" ToolTip="Click to view update details on GitHub"/>
                <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Margin="0,0,10,0" Click="OnCheckUpdatesClick"
                        ToolTip="Check for newer SpectraNetworkManager versions on GitHub Releases (Zero Telemetry)"/>
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="1" Margin="0,12,0,6">
            <RadioButton x:Name="ConnectionsTab" Content="Connections" GroupName="view" IsChecked="True"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="ProgramsTab" Content="Programs" GroupName="view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="TrafficTab" Content="Traffic" GroupName="view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="RulesTab" Content="Rules" GroupName="view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="StrictTab" Content="Strict mode" GroupName="view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="DnsTab" Content="DNS" GroupName="view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnViewChanged"/>
            <RadioButton x:Name="BlocksTab" Content="Firewall blocks" GroupName="view"
                         Margin="0,0,28,0" VerticalAlignment="Center" Checked="OnViewChanged"/>

            <Grid Width="280" Margin="0,0,20,6">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="OnFilterChanged"
                         ToolTip="Filter by program, address, host name, port or PID"/>
                <TextBlock Text="Search program, address, port, PID..." IsHitTestVisible="False"
                           Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- "__" shows a single underscore (a single one would be eaten as a keyboard shortcut marker) -->
            <CheckBox x:Name="HideNoise" Content="Hide TIME__WAIT / closing" IsChecked="True"
                      Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            <CheckBox x:Name="ShowListeners" Content="Show listening ports" IsChecked="True"
                      Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            <CheckBox x:Name="ResolveHosts" Content="Resolve host names" IsChecked="True"
                      Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnResolveHostsChanged"
                      ToolTip="Looks up a name for each remote IP using your DNS server (reverse DNS)."/>
            <CheckBox x:Name="AskMode" Content="Ask about new programs" IsChecked="True"
                      VerticalAlignment="Center" Checked="OnAskModeChanged" Unchecked="OnAskModeChanged"
                      ToolTip="Shows an Allow / Block question when a program without a decision first reaches the internet. Nothing is blocked until you answer Block."/>
            <CheckBox x:Name="AlwaysAdminCheck" Content="Always run as admin"
                      VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnAlwaysAdminChanged" Unchecked="OnAlwaysAdminChanged"
                      ToolTip="When checked, SpectraNetworkManager will automatically request Administrator elevation on launch."/>
        </WrapPanel>

        <!-- Ask mode: decision bar -->
        <Border x:Name="DecisionBar" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,10" Padding="14,10"
                Background="{StaticResource Selected}" BorderBrush="{StaticResource Magenta}" BorderThickness="1" CornerRadius="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="AskAllowButton" Content="Allow" Margin="0,0,8,0" Click="OnAskAllow"/>
                    <Button x:Name="AskBlockButton" Content="Block..." Margin="0,0,8,0" Click="OnAskBlock" Foreground="{StaticResource Magenta}"/>
                    <Button x:Name="AskTrustButton" Content="Trust publisher" Margin="0,0,8,0" Click="OnAskTrust" Visibility="Collapsed"
                            ToolTip="Allow this and stop asking about anything with a verified signature from the same publisher."/>
                    <Button x:Name="AskLaterButton" Content="Later" Click="OnAskLater"
                            ToolTip="Decide later. The program stays marked NEW in the Programs view."/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="AskTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AskDetail" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Text}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Connections view -->
        <Grid x:Name="ConnectionsPanel" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ConnectionsGrid" Grid.Column="0" ItemsSource="{Binding Rows}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close This Connection" Click="OnCloseSelectedConnection"/>
                        <MenuItem Header="Close All Connections for Program" Click="OnCloseConnectionProgram"/>
                        <MenuItem Header="End Process (Kill)" Click="OnKillConnectionProcess"/>
                        <Separator/>
                        <MenuItem Header="Block Program..." Click="OnBlockConnectionProgram"/>
                        <MenuItem Header="Allow Program" Click="OnAllowConnectionProgram"/>
                        <Separator/>
                        <MenuItem Header="Copy Remote Address" Click="OnCopyConnectionRemote"/>
                        <MenuItem Header="Open File Location" Click="OnOpenConnectionLocation"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="PROGRAM" Binding="{Binding Program, Mode=OneWay}" Width="190"/>
                    <DataGridTextColumn Header="IN/s" Binding="{Binding SpeedIn, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="OUT/s" Binding="{Binding SpeedOut, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" Width="64"/>
                    <DataGridTextColumn Header="LOCAL" Binding="{Binding Local, Mode=OneWay}" Width="200"/>
                    <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote, Mode=OneWay}" Width="220"/>
                    <DataGridTextColumn Header="HOST" Binding="{Binding Host, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="STATE" Binding="{Binding State, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="SIGNER" Binding="{Binding Signer, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIVE EVENTS" Margin="12,10,12,6" FontWeight="SemiBold"
                               Foreground="{StaticResource Magenta}"/>
                    <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="4,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Opened}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Alert}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Programs view -->
        <Grid x:Name="ProgramsPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Nothing is blocked unless you say so. Programs that reach the internet without a decision are marked NEW (magenta). 'Allow' only records your decision; 'Block' adds Windows Firewall rules (needs Administrator). All decisions, including for programs that are not running, are in the Rules view."/>
            <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                <Button x:Name="AllowButton" Content="Allow" Margin="0,0,8,0" Click="OnAllowProgram"
                        ToolTip="Record that this program is OK. Removes a block if there was one."/>
                <Button x:Name="BlockButton" Content="Block..." Margin="0,0,8,0" Click="OnBlockProgram"
                        ToolTip="Block this program's inbound and outbound traffic using Windows Firewall."/>
                <Button x:Name="CloseConnectionsButton" Content="Close connections" Margin="0,0,8,0" Click="OnCloseProgramConnections"
                        ToolTip="Immediately terminate all open IPv4 TCP connections currently active for the selected program."/>
                <Button x:Name="ForgetButton" Content="Forget decision" Margin="0,0,8,0" Click="OnForgetProgram"
                        ToolTip="Remove your decision (and the block, if any) for this program."/>
                <Button x:Name="TrustButton" Content="Trust publisher" Margin="0,0,8,0" Click="OnTrustPublisher"
                        ToolTip="Stop asking about programs from this publisher. Only works for a verified signature, and your own Block decisions still win."/>
                <Button x:Name="PanicButton" Content="PANIC: undo all SpectraNetworkManager changes" DockPanel.Dock="Right" Click="OnPanic"
                        Foreground="{StaticResource Magenta}"
                        ToolTip="Switches strict mode off and deletes every Windows Firewall rule SpectraNetworkManager created."/>
            </DockPanel>
            <DataGrid x:Name="ProgramsGrid" Grid.Row="2" ItemsSource="{Binding Programs}" SelectionMode="Single">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close Open Connections" Click="OnCloseProgramConnections"/>
                        <MenuItem Header="End Process (Kill)" Click="OnKillProgramProcess"/>
                        <Separator/>
                        <MenuItem Header="Block..." Click="OnBlockProgram"/>
                        <MenuItem Header="Allow" Click="OnAllowProgram"/>
                        <Separator/>
                        <MenuItem Header="Open File Location" Click="OnOpenProgramLocation"/>
                        <MenuItem Header="Copy Program Path" Click="OnCopyProgramPath"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROGRAM" Binding="{Binding Name, Mode=OneWay}" Width="200"/>
                    <DataGridTextColumn Header="DECISION" Binding="{Binding Verdict, Mode=OneWay}" Width="160"/>
                    <DataGridTextColumn Header="IN/s" Binding="{Binding SpeedIn, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="OUT/s" Binding="{Binding SpeedOut, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="INTERNET PEERS" Binding="{Binding InternetPeers, Mode=OneWay}" Width="130"/>
                    <DataGridTextColumn Header="ESTABLISHED" Binding="{Binding Established, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="LISTENING" Binding="{Binding Listening, Mode=OneWay}" Width="95"/>
                    <DataGridTextColumn Header="UDP" Binding="{Binding UdpEndpoints, Mode=OneWay}" Width="60"/>
                    <DataGridTextColumn Header="PROCS" Binding="{Binding Processes, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="SIGNER" Binding="{Binding Signer, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Traffic & Bandwidth view -->
        <Grid x:Name="TrafficPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Traffic Toolbar & Controls -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="Time range:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="TrafficRange1h" Content="1 Hour" GroupName="trafficRange" IsChecked="True"
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <RadioButton x:Name="TrafficRange24h" Content="24 Hours" GroupName="trafficRange"
                                 Margin="0,0,12,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <RadioButton x:Name="TrafficRange7d" Content="7 Days" GroupName="trafficRange"
                                 Margin="0,0,20,0" VerticalAlignment="Center" Checked="OnTrafficRangeChanged"/>
                    <Button Content="Refresh" Padding="14,3" Margin="0,0,10,0" Click="OnRefreshTraffic"/>
                    <Button Content="Export CSV" Padding="14,3" Margin="0,0,10,0" Click="OnExportTrafficCsv"/>
                    <Button Content="Export JSON" Padding="14,3" Margin="0,0,10,0" Click="OnExportTrafficJson"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Copy Support Info" Padding="12,3" Foreground="{StaticResource Cyan}" Click="OnCopySupportInfo"
                            ToolTip="Copies a sanitized system and SpectraNetworkManager diagnostics report to clipboard with personal user paths redacted."/>
                </StackPanel>
            </DockPanel>

            <!-- Splitter: Top Talkers vs Connection History -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Top Talkers -->
                <GroupBox Grid.Column="0" Header="TOP TALKERS" Foreground="{StaticResource Cyan}" BorderBrush="{StaticResource Line}">
                    <DataGrid x:Name="TopTalkersGrid" ItemsSource="{Binding TopTalkers}" Margin="4" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROGRAM" Binding="{Binding ProgramName, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="IN" Binding="{Binding DownloadFormatted, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="OUT" Binding="{Binding UploadFormatted, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFormatted, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="LAST ACTIVE" Binding="{Binding LastActiveFormatted, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Program, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                <!-- Right: Connection History -->
                <GroupBox Grid.Column="2" Header="RECENT CONNECTION HISTORY" Foreground="{StaticResource Magenta}" BorderBrush="{StaticResource Line}">
                    <DataGrid x:Name="ConnectionHistoryGrid" ItemsSource="{Binding ConnectionHistory}" Margin="4" AutoGenerateColumns="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PROGRAM" Binding="{Binding ProgramName, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="PORT" Binding="{Binding Port, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="PROTO" Binding="{Binding Proto, Mode=OneWay}" Width="60"/>
                            <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeenFormatted, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="FIRST SEEN" Binding="{Binding FirstSeenFormatted, Mode=OneWay}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Rules view: every stored decision, whether or not the program is running -->
        <Grid x:Name="RulesPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Every decision you made, even for programs that are not running right now. FIREWALL shows whether Windows Firewall really contains the matching block rules (MISSING = the rules were removed outside SpectraNetworkManager)."/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="RulesRefreshButton" Content="Refresh" Margin="0,0,8,0" Click="OnRefreshRules"/>
                <Button x:Name="RulesEditButton" Content="Edit block..." Margin="0,0,8,0" Click="OnRulesEdit"
                        ToolTip="Change direction, ports or addresses of the selected block (or turn an Allow into a block)."/>
                <Button x:Name="RulesAllowButton" Content="Allow" Margin="0,0,8,0" Click="OnRulesAllow"
                        ToolTip="Switch the selected decision to Allow (removes the block)."/>
                <Button x:Name="RulesForgetButton" Content="Forget decision" Margin="0,0,8,0" Click="OnRulesForget"
                        ToolTip="Remove the selected decision and its firewall rules."/>
                <Button x:Name="RulesPanicButton" Content="PANIC: undo all SpectraNetworkManager changes" Click="OnPanic" Foreground="{StaticResource Magenta}"/>
            </StackPanel>
            <DataGrid x:Name="RulesGrid" Grid.Row="2" ItemsSource="{Binding RuleRows}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROGRAM" Binding="{Binding Name, Mode=OneWay}" Width="220"/>
                    <DataGridTextColumn Header="DECISION" Binding="{Binding Decision, Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="TRAFFIC" Binding="{Binding Direction, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="BLOCKS" Binding="{Binding Scope, Mode=OneWay}" Width="260"/>
                    <DataGridTextColumn Header="FIREWALL" Binding="{Binding Firewall, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="SINCE" Binding="{Binding Since, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="PATH" Binding="{Binding Path, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,8">
                <TextBlock Text="TRUSTED PUBLISHERS" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="UntrustButton" Content="Remove trust" Click="OnUntrustPublisher"/>
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Muted}"
                           Text="Programs with a verified signature from these publishers are not asked about. Your own Block decisions still win."/>
            </StackPanel>
            <DataGrid x:Name="PublishersGrid" Grid.Row="4" ItemsSource="{Binding Publishers}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Strict mode view -->
        <Grid x:Name="StrictPanel" Grid.Row="3" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                    <TextBlock x:Name="StrictStatus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Amber}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Strict mode switches Windows Firewall's default for outgoing connections to BLOCK. Only programs with an allow rule can connect out: your own Allow decisions, programs from publishers you trust, and a short list of Windows basics. Everything else is blocked and shows up in the Ask bar so you can decide."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="StrictEnableButton" Content="Enable strict mode..." Click="OnStrictEnable"
                                Margin="0,0,10,0" Foreground="{StaticResource Magenta}"/>
                        <Button x:Name="StrictDisableButton" Content="Turn off strict mode" Click="OnStrictDisable" Margin="0,0,10,0"/>
                        <Button x:Name="AuditButton" Content="Enable blocked-connection auditing" Click="OnEnableAudit"
                                ToolTip="Lets Windows record blocked connections in the Security log (needed for the Firewall blocks view and for strict mode prompts)."/>
                    </StackPanel>

                    <TextBlock Text="ALWAYS ALLOWED IN STRICT MODE" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Windows' built-in Core Networking rules (DHCP, DNS, IPv6) stay as they are. SpectraNetworkManager adds: the Windows kernel (System), svchost.exe (hosts most Windows services such as Windows Update, time sync and the DNS client), lsass.exe (sign-in), the Windows Defender services, and SpectraNetworkManager itself."/>

                    <TextBlock Text="GOOD TO KNOW" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- A program's first attempt fails: SpectraNetworkManager can only ask after the connection was blocked. Allow it and retry."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- Allow rules are per exe file. When a program updates into a new folder (browsers often do), it is asked about again unless its publisher is trusted."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="- Microsoft Store apps and some Windows components may behave differently. If one stops working, check the Ask bar."/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="- Incoming connections are not changed: Windows already blocks them by default."/>

                    <TextBlock Text="IF YOU GET LOCKED OUT" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Start SpectraNetworkManager as Administrator and press PANIC. Or, in an administrator command prompt:"/>
                    <TextBox IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Text="netsh advfirewall set allprofiles firewallpolicy blockinbound,allowoutbound"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- DNS sinkhole view -->
        <Grid x:Name="DnsPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="DnsStatus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DnsCounters" Margin="0,4,0,0" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Cyan}"/>
                <TextBlock x:Name="DnsNotes" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                <Button x:Name="DnsStartButton" Content="Start DNS server" Click="OnDnsStart" Margin="0,0,8,6" Foreground="{StaticResource Cyan}"/>
                <Button x:Name="DnsStopButton" Content="Stop" Click="OnDnsStop" Margin="0,0,8,6"/>
                <Button x:Name="DnsPauseButton" Content="Pause blocking" Click="OnDnsPauseClick" Margin="0,0,8,6"
                        ToolTip="Temporarily disable blocking for 5, 15, or 30 minutes (like Pi-hole)."/>
                <Button x:Name="DnsTestButton" Content="Test my DNS server" Click="OnDnsSelfTest" Margin="0,0,8,6"
                        ToolTip="Sends a real query for example.com and for a blocked name to the running server, on its own port."/>
                <Button Content="Update block lists" Click="OnDnsUpdateLists" Margin="0,0,8,6"
                        ToolTip="Downloads the lists in the settings (needs internet; with strict mode on, SpectraNetworkManager itself is allowed)."/>
                <Button Content="Flush cache" Click="OnDnsFlush" Margin="0,0,8,6"/>
                <Button Content="Clear log" Click="OnDnsClearLog" Margin="0,0,8,6"/>
                <Button Content="Export CSV" Click="OnDnsExportCsv" Margin="0,0,20,6"
                        ToolTip="Export persistent SQLite query history to a CSV file."/>
                <Button Content="Always allow selected" Click="OnDnsAllow" Margin="0,0,8,6" ToolTip="Adds the selected log line's domain to your allow list."/>
                <Button Content="Always block selected" Click="OnDnsBlock" Margin="0,0,20,6" Foreground="{StaticResource Magenta}"
                        ToolTip="Adds the selected log line's domain to your block list."/>
                <TextBox x:Name="DnsCheckBox" Width="220" Margin="0,0,8,6" VerticalContentAlignment="Center"
                         ToolTip="Type a domain and press Check to see what the filter would do, without sending a query."/>
                <Button Content="Check" Click="OnDnsCheck" Margin="0,0,10,6"/>
                <TextBlock x:Name="DnsCheckResult" VerticalAlignment="Center" Margin="0,0,0,6" Foreground="{StaticResource Text}"/>
            </WrapPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="DnsGrid" Grid.Column="0" ItemsSource="{Binding DnsRows}" SelectionMode="Single">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Magenta}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding Time, Mode=OneWay}" Width="80"/>
                        <DataGridTextColumn Header="CLIENT" Binding="{Binding Client, Mode=OneWay}" Width="120"/>
                        <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain, Mode=OneWay}" Width="260"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="RESULT" Binding="{Binding Result, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="MS" Binding="{Binding Ms, Mode=OneWay}" Width="55"/>
                        <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail, Mode=OneWay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10,14,14">
                            <TextBlock Text="SETTINGS" FontWeight="SemiBold" Foreground="{StaticResource Magenta}" Margin="0,0,0,8"/>

                            <TextBlock Text="Listen address" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsListenBox" Margin="0,2,0,2"
                                     ToolTip="127.0.0.1 = only this PC. 0.0.0.0 = also other devices on your network."/>
                            <TextBlock Text="127.0.0.1 = only this PC.  0.0.0.0 = also your network." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>

                            <TextBlock Text="Port" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsPortBox" Margin="0,2,0,2"/>
                            <TextBlock Text="53 is the normal DNS port. If it is taken, try 5353 and use 'Test my DNS server' (Windows' nslookup only talks to port 53)." FontSize="11"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Upstream DNS servers (answer what is not blocked)" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="DnsUpstreamsBox" Margin="0,2,0,4"
                                     ToolTip="IP addresses (9.9.9.9), DoH URLs (https://9.9.9.9/dns-query), or DoT (tls://9.9.9.9:853)."/>

                            <!-- Upstream Presets -->
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="Presets:" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="Quad9 DoH" Click="OnPresetQuad9Doh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Cloudflare DoH" Click="OnPresetCloudflareDoh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Google DoH" Click="OnPresetGoogleDoh" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Quad9 DoT" Click="OnPresetQuad9Dot" FontSize="10" Padding="4,1" Margin="0,0,4,2"/>
                                <Button Content="Standard" Click="OnPresetStandard" FontSize="10" Padding="4,1" Margin="0,0,0,2"/>
                            </WrapPanel>
                            <TextBlock x:Name="DnsUpstreamStatusText" FontSize="10" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Blocked names get" Foreground="{StaticResource Muted}"/>
                            <RadioButton x:Name="DnsNullRadio" Content="0.0.0.0 / :: (fast, programs fail at once)" GroupName="blockmode" Margin="0,4,0,2"/>
                            <RadioButton x:Name="DnsNxRadio" Content="'does not exist' (NXDOMAIN)" GroupName="blockmode" Margin="0,2,0,8"/>

                            <CheckBox x:Name="InspectCnameBox" Content="Also block names that are only an alias of a blocked name" Margin="0,2,0,2"/>
                            <CheckBox x:Name="BlockDohBox" Content="Tell Firefox not to bypass this DNS (its DoH check)" Margin="0,2,0,2"/>
                            <CheckBox x:Name="AutoStartDnsBox" Content="Start the DNS server when SpectraNetworkManager starts" Margin="0,2,0,4"/>
                            <CheckBox x:Name="RestrictClientsBox" Content="Only answer queries from local / private networks" Margin="0,2,0,4"
                                      ToolTip="Protects your PC from acting as an open resolver on the internet if listening on 0.0.0.0."/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBlock Text="Rate limit:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBox x:Name="DnsRateLimitBox" Width="50" VerticalContentAlignment="Center"
                                         ToolTip="Maximum queries per second per client IP (0 = unlimited). Mitigates DNS amplification floods."/>
                                <TextBlock Text="queries / sec per IP" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="LOG PRIVACY &amp; RETENTION" FontWeight="SemiBold" Foreground="{StaticResource Magenta}" FontSize="10" Margin="0,4,0,4"/>
                            <CheckBox x:Name="AnonymizeIpsBox" Content="Anonymize client IP addresses in query history" Margin="0,2,0,2"
                                      ToolTip="Masks the last octet of IPv4 and /64 of IPv6 client addresses."/>
                            <CheckBox x:Name="DoNotStoreDomainsBox" Content="Do not store domain names in history log ([redacted])" Margin="0,2,0,4"
                                      ToolTip="Prevents domain names from being recorded in the persistent SQLite database."/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                <TextBlock Text="History retention:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                                <TextBox x:Name="RetentionDaysBox" Width="40" VerticalContentAlignment="Center"
                                         ToolTip="Number of days to keep query logs in the SQLite database (0 = never delete)."/>
                                <TextBlock Text="days" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="6,0,0,0" FontSize="11"/>
                            </StackPanel>

                            <TextBlock Text="Block lists (one per line:  Name | URL;  start a line with # to switch it off)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ListsBox" Margin="0,2,0,8" Height="84" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Always block (one per line; a domain also blocks its subdomains; /regex/ allowed)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="CustomBlockBox" Margin="0,2,0,8" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Always allow (wins over every block list)" Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="CustomAllowBox" Margin="0,2,0,8" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Text="Local DNS records (domain | type | value, e.g. nas.home | A | 192.168.1.100)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="LocalRecordsBox" Margin="0,2,0,8" Height="50" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     ToolTip="Authoritative custom records served directly by SpectraNetworkManager without upstream lookups."/>

                            <TextBlock Text="Conditional forwarding (domain suffix | target server, e.g. lan | 192.168.1.1)" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <TextBox x:Name="ConditionalForwardingBox" Margin="0,2,0,10" Height="50" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                     ToolTip="Forwards router/LAN domains or reverse PTR zones directly to your router."/>

                            <Button Content="Save settings" Click="OnDnsSave" Foreground="{StaticResource Cyan}" HorizontalAlignment="Left" Margin="0,0,0,14"
                                    ToolTip="Saves, and restarts the DNS server if it is running."/>

                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,4,0,12"/>

                            <TextBlock Text="POINT THIS PC TO SPECTRANETWORKMANAGER" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="One click points your network adapters to SpectraNetworkManager (127.0.0.1 / ::1) to block ads and trackers across your entire PC. Backs up your existing DNS first, with an automatic 60-second rollback if unconfirmed."/>

                            <!-- Status banner -->
                            <Border x:Name="DnsSwitchBanner" Background="{StaticResource Panel}" BorderBrush="{StaticResource Amber}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DnsSwitchStatus" FontWeight="SemiBold" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DnsSwitchDetails" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Select network adapters to point at SpectraNetworkManager:" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="DnsAdaptersList" Margin="0,0,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2,0,2">
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="11"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <CheckBox x:Name="DnsFallbackModeBox" Content="Fallback mode (keep previous DNS as secondary backup)" IsChecked="True" Margin="0,0,0,8"
                                      ToolTip="Recommended. If SpectraNetworkManager is stopped, your computer can still reach your previous DNS servers."/>

                            <WrapPanel Margin="0,0,0,12">
                                <Button x:Name="DnsApplySwitchButton" Content="Point PC to SpectraNetworkManager..." Click="OnDnsSwitchApply" Margin="0,0,8,6" Foreground="{StaticResource Cyan}"/>
                                <Button x:Name="DnsRestoreSwitchButton" Content="Restore original DNS" Click="OnDnsSwitchRestore" Margin="0,0,8,6"/>
                                <Button Content="Refresh adapters" Click="OnDnsRefreshAdapters" Margin="0,0,8,6"/>
                            </WrapPanel>

                            <TextBlock Text="BROWSER SECURE DNS (DoH) NOTICE" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Browsers (Chrome, Edge) sometimes bypass Windows DNS with built-in DNS-over-HTTPS. In Chrome/Edge settings under Privacy &amp; Security -> Use secure DNS, select 'With your current service provider' (or disable it)."/>

                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                            <TextBlock Text="OTHER DEVICES ON YOUR NETWORK" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Set the listen address to 0.0.0.0, then allow DNS requests from your local network in Windows Firewall (only your home network, never public networks). Then point your router's DNS (or a device's DNS) at this PC."/>
                            <WrapPanel>
                                <Button Content="Allow local network" Click="OnDnsAllowLan" Margin="0,0,8,0"/>
                                <Button Content="Remove permission" Click="OnDnsRemoveLan"/>
                            </WrapPanel>

                            <TextBlock x:Name="DnsTop" Margin="0,16,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Firewall blocks view -->
        <Grid x:Name="BlocksPanel" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="RefreshBlocksButton" Content="Refresh" Padding="16,4" Margin="0,0,14,0" Click="OnRefreshBlocks"/>
                <TextBlock x:Name="BlocksHint" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           Text="Shows connections Windows Firewall blocked in the last hour."/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Blocks}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="DIR" Binding="{Binding Direction, Mode=OneWay}" Width="60"/>
                    <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination, Mode=OneWay}" Width="230"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding Application, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Copy Support Info" Padding="10,2" Margin="10,0,0,0" FontSize="11"
                    Foreground="{StaticResource Cyan}" Click="OnCopySupportInfo"
                    ToolTip="Copies a sanitized system and SpectraNetworkManager diagnostics report to clipboard with personal user paths redacted."/>
            <TextBlock x:Name="StatusAdminIndicator" DockPanel.Dock="Right" Text="[ Mode: Administrator ]" FontSize="11"
                       Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="10,0,14,0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="Starting..." VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
