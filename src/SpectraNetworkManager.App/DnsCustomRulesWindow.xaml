<Window x:Class="SpectraNetworkManager.Ui.DnsCustomRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS Filter Rules &amp; Blocklists" Width="780" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DNS FILTER RULES" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="  //  custom block &amp; allow list" FontSize="12" Foreground="{StaticResource Magenta}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <TextBlock Text="Manage domains you have manually blocked or whitelisted, or inspect downloaded subscription lists."
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- View Switcher Tabs -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <RadioButton x:Name="TabBlocked" Content="🚫 Custom Blocked (0)" GroupName="rules_view" IsChecked="True"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
            <RadioButton x:Name="TabAllowed" Content="🛡️ Custom Whitelist (0)" GroupName="rules_view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
            <RadioButton x:Name="TabSubscriptions" Content="📁 Subscription Lists (0)" GroupName="rules_view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
        </WrapPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- 1. CUSTOM BLOCKED PANEL -->
            <Grid x:Name="PanelBlocked" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBlockedBox" TextChanged="OnSearchBlockedChanged" VerticalContentAlignment="Center"
                             ToolTip="Filter custom blocked domains"/>
                </DockPanel>

                <DataGrid x:Name="BlockedGrid" Grid.Row="1" SelectionMode="Single" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BLOCKED DOMAIN" Binding="{Binding Domain}" Width="*" Foreground="{StaticResource Magenta}"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✕ Remove" Click="OnRemoveBlockedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Amber}" ToolTip="Remove from custom blocklist (undo block)"/>
                                        <Button Content="🛡️ Allow" Click="OnMoveToAllowedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Cyan}" ToolTip="Move to custom allow list"/>
                                        <Button Content="🌐" Click="OnLookupBlockedItem" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Search online on VirusTotal"/>
                                        <Button Content="📋" Click="OnCopyBlockedItem" Padding="4,1"
                                                ToolTip="Copy domain to clipboard"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add new blocked domain bar -->
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="+ Add to Blocklist" Click="OnAddBlockClick"
                            Margin="8,0,0,0" Padding="12,4" Foreground="{StaticResource Magenta}"/>
                    <TextBox x:Name="NewBlockBox" VerticalContentAlignment="Center" KeyDown="OnNewBlockKeyDown"
                             ToolTip="Type a domain (e.g. adserver.com or *.tracker.com) and press Enter to block."/>
                </DockPanel>
            </Grid>

            <!-- 2. CUSTOM ALLOWED PANEL -->
            <Grid x:Name="PanelAllowed" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchAllowedBox" TextChanged="OnSearchAllowedChanged" VerticalContentAlignment="Center"
                             ToolTip="Filter custom allowed domains"/>
                </DockPanel>

                <DataGrid x:Name="AllowedGrid" Grid.Row="1" SelectionMode="Single" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ALLOWED DOMAIN (WHITELIST)" Binding="{Binding Domain}" Width="*" Foreground="{StaticResource Cyan}"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✕ Remove" Click="OnRemoveAllowedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Amber}" ToolTip="Remove from whitelist"/>
                                        <Button Content="🚫 Block" Click="OnMoveToBlockedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Magenta}" ToolTip="Move to custom blocklist"/>
                                        <Button Content="🌐" Click="OnLookupAllowedItem" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Search online on VirusTotal"/>
                                        <Button Content="📋" Click="OnCopyAllowedItem" Padding="4,1"
                                                ToolTip="Copy domain to clipboard"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add new allowed domain bar -->
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="+ Add to Whitelist" Click="OnAddAllowClick"
                            Margin="8,0,0,0" Padding="12,4" Foreground="{StaticResource Cyan}"/>
                    <TextBox x:Name="NewAllowBox" VerticalContentAlignment="Center" KeyDown="OnNewAllowKeyDown"
                             ToolTip="Type a domain (e.g. example.com) and press Enter to allow."/>
                </DockPanel>
            </Grid>

            <!-- 3. SUBSCRIPTIONS PANEL -->
            <Grid x:Name="PanelSubscriptions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Directory info & quick actions -->
                <Border Grid.Row="0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="📁 Open Folder in Explorer" Click="OnOpenBlocklistsFolder"
                                Padding="10,3" Margin="8,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Local Storage Directory:" FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StoragePathText" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Cyan}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Lists grid -->
                <DataGrid x:Name="SubscriptionsGrid" Grid.Row="1" SelectionMode="Single" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LIST NAME" Binding="{Binding Name}" Width="200" Foreground="{StaticResource Cyan}"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="160"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding FileSize}" Width="80"/>
                        <DataGridTextColumn Header="LAST UPDATED" Binding="{Binding LastModified}" Width="140"/>
                        <DataGridTextColumn Header="SOURCE URL" Binding="{Binding Url}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Actions -->
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="SubscriptionTotalText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <Button DockPanel.Dock="Right" Content="🔄 Update All Block Lists" Click="OnUpdateAllListsClick"
                            Padding="14,4" Foreground="{StaticResource Cyan}"/>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="DialogStatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Padding="18,4"/>
        </DockPanel>
    </Grid>
</Window>
