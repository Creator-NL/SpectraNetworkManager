<Window x:Class="SpectraNetworkManager.Ui.DnsCustomRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNS &amp; Mobile Filter Rules &amp; Blocklists" Width="860" Height="620" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FILTER RULES &amp; BLOCKLISTS" FontSize="18" FontWeight="Bold" FontFamily="Bahnschrift" Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="  //  separated PC vs. Phone &amp; Smart TV lists" FontSize="12" Foreground="{StaticResource Magenta}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <TextBlock Text="PC rules and Phone/TV rules are stored in completely separate files so what you block on your phone never affects your PC."
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Target Scope Selector (PC vs. Phone & Smart TV) -->
        <Border Grid.Row="1" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="RULE TARGET:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Amber}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="ScopePcRadio" Content="💻 PC Rules (0)" GroupName="rule_scope" IsChecked="True"
                                 Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnScopeChanged"
                                 ToolTip="Manage custom block &amp; allow rules that apply only to this PC (stored in dns-settings.json)"/>
                    <RadioButton x:Name="ScopeTvMobileRadio" Content="📱 Phone &amp; Smart TV Rules (0)" GroupName="rule_scope"
                                 Margin="0,0,18,0" VerticalAlignment="Center" Checked="OnScopeChanged"
                                 ToolTip="Manage custom block &amp; allow rules that apply only to Phones, Tablets &amp; Smart TVs on your LAN (stored in tv-mobile-rules.json)"/>
                    <Button DockPanel.Dock="Right" Content="📂 Open Rule File in Explorer" Click="OnOpenActiveRuleFileFolderClick"
                            Padding="10,2" FontSize="11" ToolTip="Open folder and highlight the active JSON rule file in Windows Explorer"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Active Storage File: " FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="ActiveRuleFileText" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Cyan}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- View Switcher Tabs -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <RadioButton x:Name="TabBlocked" Content="🚫 Custom Blocked (0)" GroupName="rules_view" IsChecked="True"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
            <RadioButton x:Name="TabAllowed" Content="🛡️ Custom Whitelist (0)" GroupName="rules_view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
            <RadioButton x:Name="TabSubscriptions" Content="📁 Shared Subscription Lists (0)" GroupName="rules_view"
                         Margin="0,0,16,0" VerticalAlignment="Center" Checked="OnTabChanged"/>
        </WrapPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="3">
            <!-- 1. CUSTOM BLOCKED PANEL -->
            <Grid x:Name="PanelBlocked" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button x:Name="MoveScopeBlockedBtn" Content="📱 Move Selected to Phone &amp; TV" Click="OnMoveSelectedBlockedBetweenScopesClick"
                                Margin="0,0,6,0" Padding="8,2" Foreground="{StaticResource Cyan}"
                                ToolTip="Move selected blocked domains to the other device scope (PC ↔ Phone &amp; TV)"/>
                        <Button Content="🗑️ Remove Selected" Click="OnRemoveSelectedBlockedClick" Margin="0,0,6,0" Padding="8,2"
                                Foreground="{StaticResource Magenta}" ToolTip="Remove all currently selected rules (or press Delete)"/>
                        <Button Content="💥 Clear All" Click="OnClearAllBlockedClick" Padding="8,2"
                                Foreground="{StaticResource Amber}" ToolTip="Remove all custom blocked rules in the active scope"/>
                    </StackPanel>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchBlockedBox" TextChanged="OnSearchBlockedChanged" VerticalContentAlignment="Center"
                             ToolTip="Filter custom blocked domains"/>
                </DockPanel>

                <DataGrid x:Name="BlockedGrid" Grid.Row="1" SelectionMode="Extended" Margin="0,0,0,10"
                          KeyDown="OnBlockedGridKeyDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🗑️ Remove Selected" Click="OnRemoveSelectedBlockedClick" Foreground="{StaticResource Magenta}"/>
                            <MenuItem Header="🛡️ Move Selected to Whitelist" Click="OnMoveSelectedToAllowedClick" Foreground="{StaticResource Cyan}"/>
                            <MenuItem x:Name="MoveScopeBlockedMenuItem" Header="📱 Move Selected to Phone &amp; TV List" Click="OnMoveSelectedBlockedBetweenScopesClick" Foreground="{StaticResource Amber}"/>
                            <Separator/>
                            <MenuItem Header="🔎 WHOIS Lookup" Click="OnWhoisBlockedContextItem"/>
                            <MenuItem Header="🌐 Search Online (VirusTotal)" Click="OnLookupBlockedContextItem"/>
                            <MenuItem Header="📋 Copy Domain" Click="OnCopyBlockedContextItem"/>
                            <Separator/>
                            <MenuItem Header="💥 Clear All Custom Blocked Rules" Click="OnClearAllBlockedClick" Foreground="{StaticResource Amber}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BLOCKED DOMAIN" Binding="{Binding Domain}" Width="*" Foreground="{StaticResource Magenta}"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✕ Remove" Click="OnRemoveBlockedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Amber}" ToolTip="Remove from custom blocklist (undo block)"/>
                                        <Button Content="🛡️ Allow" Click="OnMoveToAllowedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Cyan}" ToolTip="Move to custom allow list"/>
                                        <Button Content="🔎" Click="OnWhoisBlockedItemButton" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Lookup domain WHOIS registration &amp; owner"/>
                                        <Button Content="🌐" Click="OnLookupBlockedItem" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Search online on VirusTotal"/>
                                        <Button Content="📋" Click="OnCopyBlockedItem" Padding="4,1"
                                                ToolTip="Copy domain to clipboard"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add new blocked domain bar -->
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Button x:Name="AddBlockBtn" DockPanel.Dock="Right" Content="+ Add to PC Blocklist" Click="OnAddBlockClick"
                            Margin="8,0,0,0" Padding="12,4" Foreground="{StaticResource Magenta}"/>
                    <TextBox x:Name="NewBlockBox" VerticalContentAlignment="Center" KeyDown="OnNewBlockKeyDown"
                             ToolTip="Type a domain (e.g. adserver.com or *.tracker.com) and press Enter to block in the selected scope."/>
                </DockPanel>
            </Grid>

            <!-- 2. CUSTOM ALLOWED PANEL -->
            <Grid x:Name="PanelAllowed" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button x:Name="MoveScopeAllowedBtn" Content="📱 Move Selected to Phone &amp; TV" Click="OnMoveSelectedAllowedBetweenScopesClick"
                                Margin="0,0,6,0" Padding="8,2" Foreground="{StaticResource Cyan}"
                                ToolTip="Move selected whitelisted domains to the other device scope (PC ↔ Phone &amp; TV)"/>
                        <Button Content="🗑️ Remove Selected" Click="OnRemoveSelectedAllowedClick" Margin="0,0,6,0" Padding="8,2"
                                Foreground="{StaticResource Magenta}" ToolTip="Remove all currently selected rules (or press Delete)"/>
                        <Button Content="💥 Clear All" Click="OnClearAllAllowedClick" Padding="8,2"
                                Foreground="{StaticResource Amber}" ToolTip="Remove all custom whitelisted rules in the active scope"/>
                    </StackPanel>
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchAllowedBox" TextChanged="OnSearchAllowedChanged" VerticalContentAlignment="Center"
                             ToolTip="Filter custom allowed domains"/>
                </DockPanel>

                <DataGrid x:Name="AllowedGrid" Grid.Row="1" SelectionMode="Extended" Margin="0,0,0,10"
                          KeyDown="OnAllowedGridKeyDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🗑️ Remove Selected" Click="OnRemoveSelectedAllowedClick" Foreground="{StaticResource Magenta}"/>
                            <MenuItem Header="🚫 Move Selected to Blocklist" Click="OnMoveSelectedToBlockedClick" Foreground="{StaticResource Magenta}"/>
                            <MenuItem x:Name="MoveScopeAllowedMenuItem" Header="📱 Move Selected to Phone &amp; TV List" Click="OnMoveSelectedAllowedBetweenScopesClick" Foreground="{StaticResource Amber}"/>
                            <Separator/>
                            <MenuItem Header="🔎 WHOIS Lookup" Click="OnWhoisAllowedContextItem"/>
                            <MenuItem Header="🌐 Search Online (VirusTotal)" Click="OnLookupAllowedContextItem"/>
                            <MenuItem Header="📋 Copy Domain" Click="OnCopyAllowedContextItem"/>
                            <Separator/>
                            <MenuItem Header="💥 Clear All Whitelist Rules" Click="OnClearAllAllowedClick" Foreground="{StaticResource Amber}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ALLOWED DOMAIN (WHITELIST)" Binding="{Binding Domain}" Width="*" Foreground="{StaticResource Cyan}"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✕ Remove" Click="OnRemoveAllowedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Amber}" ToolTip="Remove from whitelist"/>
                                        <Button Content="🚫 Block" Click="OnMoveToBlockedItem" Padding="6,1" Margin="0,0,4,0"
                                                Foreground="{StaticResource Magenta}" ToolTip="Move to custom blocklist"/>
                                        <Button Content="🔎" Click="OnWhoisAllowedItemButton" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Lookup domain WHOIS registration &amp; owner"/>
                                        <Button Content="🌐" Click="OnLookupAllowedItem" Padding="4,1" Margin="0,0,4,0"
                                                ToolTip="Search online on VirusTotal"/>
                                        <Button Content="📋" Click="OnCopyAllowedItem" Padding="4,1"
                                                ToolTip="Copy domain to clipboard"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add new allowed domain bar -->
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Button x:Name="AddAllowBtn" DockPanel.Dock="Right" Content="+ Add to PC Whitelist" Click="OnAddAllowClick"
                            Margin="8,0,0,0" Padding="12,4" Foreground="{StaticResource Cyan}"/>
                    <TextBox x:Name="NewAllowBox" VerticalContentAlignment="Center" KeyDown="OnNewAllowKeyDown"
                             ToolTip="Type a domain (e.g. example.com) and press Enter to allow in the selected scope."/>
                </DockPanel>
            </Grid>

            <!-- 3. SUBSCRIPTIONS PANEL -->
            <Grid x:Name="PanelSubscriptions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Directory info & quick actions -->
                <Border Grid.Row="0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="📁 Open Folder in Explorer" Click="OnOpenBlocklistsFolder"
                                Padding="10,3" Margin="8,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Local Storage Directory:" FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="StoragePathText" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Cyan}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Lists grid -->
                <DataGrid x:Name="SubscriptionsGrid" Grid.Row="1" SelectionMode="Single" Margin="0,0,0,10">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🗑️ Unsubscribe / Remove List" Click="OnRemoveSubscriptionClick" Foreground="{StaticResource Magenta}"/>
                            <MenuItem Header="🔄 Update Block Lists" Click="OnUpdateAllListsClick"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LIST NAME" Binding="{Binding Name}" Width="200" Foreground="{StaticResource Cyan}"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="160"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding FileSize}" Width="80"/>
                        <DataGridTextColumn Header="LAST UPDATED" Binding="{Binding LastModified}" Width="140"/>
                        <DataGridTextColumn Header="SOURCE URL" Binding="{Binding Url}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Subscribe bar -->
                <Border Grid.Row="2" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="List Name (optional):" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="NewListNameBox" VerticalContentAlignment="Center" ToolTip="Friendly name, e.g. YouTube Ads Pi-hole"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Blocklist URL (raw or GitHub URL):" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
                            <TextBox x:Name="NewListUrlBox" VerticalContentAlignment="Center" KeyDown="OnNewListUrlKeyDown"
                                     ToolTip="Paste source URL (e.g. https://github.com/kboghdady/youTube_ads_4_pi-hole/blob/master/black.list)"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="➕ Subscribe to Blocklist" Click="OnSubscribeClick"
                                Padding="12,4" Foreground="{StaticResource Cyan}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <!-- Actions -->
                <DockPanel Grid.Row="3">
                    <TextBlock x:Name="SubscriptionTotalText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="🗑️ Remove Selected" Click="OnRemoveSubscriptionClick" Margin="0,0,8,0"
                                Padding="12,4" Foreground="{StaticResource Magenta}" ToolTip="Unsubscribe and remove selected blocklist"/>
                        <Button Content="🔄 Update All Block Lists" Click="OnUpdateAllListsClick"
                                Padding="14,4" Foreground="{StaticResource Cyan}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="📥 Import List..." Click="OnImportBlocklistClick" Margin="0,0,10,0" Padding="14,4"
                        Foreground="{StaticResource Cyan}" ToolTip="Import domains or wildcard rules from a Hosts file or text list into the active scope"/>
                <Button Content="💾 Export List..." Click="OnExportBlocklistClick" Margin="0,0,10,0" Padding="14,4"
                        Foreground="{StaticResource Cyan}" ToolTip="Export domains from the active scope as a Hosts file or plain domain list"/>
                <Button Content="Close" Click="OnCloseClick" Padding="18,4"/>
            </StackPanel>
            <TextBlock x:Name="DialogStatusText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
