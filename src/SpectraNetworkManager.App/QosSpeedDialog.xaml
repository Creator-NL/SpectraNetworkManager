<Window x:Class="SpectraNetworkManager.Ui.QosSpeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectra Upload Rate Limiter" Width="480" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡ UPLOAD RATE LIMITER" FontSize="15" FontWeight="Bold" FontFamily="Bahnschrift" Foreground="{StaticResource Cyan}"/>
                <TextBlock Text="  //  native Windows QoS" FontSize="11" Foreground="{StaticResource Magenta}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
            <TextBlock x:Name="TargetProgramText" Text="Target: program.exe" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Applies an outbound throttle policy via Windows NetQoS to restrict maximum upload bandwidth."
                       FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Presets Selection -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
            <StackPanel>
                <TextBlock Text="CHOOSE MAXIMUM UPLOAD SPEED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,0,0,10" FontFamily="Bahnschrift"/>

                <RadioButton x:Name="OptNoLimit" Content="♾️ Unrestricted (Remove Speed Limit)" GroupName="qosRate" IsChecked="True" Margin="0,0,0,8" FontWeight="SemiBold"/>
                <RadioButton x:Name="Opt256k" Content="🐢 256 Kbps (Background / Minimal)" GroupName="qosRate" Margin="0,0,0,8"/>
                <RadioButton x:Name="Opt512k" Content="📦 512 Kbps (Moderate Throttle)" GroupName="qosRate" Margin="0,0,0,8"/>
                <RadioButton x:Name="Opt1M" Content="⚡ 1 Mbps (Standard Limit)" GroupName="qosRate" Margin="0,0,0,8"/>
                <RadioButton x:Name="Opt2M" Content="🚀 2 Mbps" GroupName="qosRate" Margin="0,0,0,8"/>
                <RadioButton x:Name="Opt5M" Content="💨 5 Mbps" GroupName="qosRate" Margin="0,0,0,8"/>
                <RadioButton x:Name="Opt10M" Content="🏎️ 10 Mbps" GroupName="qosRate" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="OptCustom" Content="Custom Speed:" GroupName="qosRate" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="CustomSpeedBox" Width="90" Height="24" VerticalAlignment="Center" Text="2000" ToolTip="Enter speed"/>
                    <ComboBox x:Name="CustomUnitCombo" Width="70" Height="24" VerticalAlignment="Center" Margin="6,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Kbps"/>
                        <ComboBoxItem Content="Mbps"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Apply Limit" Click="OnApplyClick" Padding="14,4" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancelClick" Padding="12,4"/>
            <TextBlock x:Name="CurrentLimitNoticeText" Text="Requires Administrator privileges." VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}"/>
        </DockPanel>
    </Grid>
</Window>
