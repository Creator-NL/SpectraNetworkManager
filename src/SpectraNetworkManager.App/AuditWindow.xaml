<Window x:Class="SpectraNetworkManager.Ui.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spectra System &amp; Security Audit" Width="760" Height="620" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="🔄 Re-Run Audit" Click="OnRerunAuditClick" Margin="0,0,8,0" Padding="10,4" Foreground="{StaticResource Cyan}"/>
                <Button Content="📋 Copy Report" Click="OnCopyReportClick" Padding="10,4"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🩺 SYSTEM &amp; SECURITY AUDIT" FontSize="16" FontWeight="Bold" FontFamily="Bahnschrift" Foreground="{StaticResource Cyan}"/>
                    <TextBlock Text="  //  full configuration health check" FontSize="11" Foreground="{StaticResource Magenta}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <TextBlock Text="Audits your local DNS pointer, sinkhole listener, firewall rules, strict mode, and active security shields."
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Health Score Dashboard Deck -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Score Card -->
                <Border Grid.Column="0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="AuditScoreText" DockPanel.Dock="Right" Text="100" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HEALTH SCORE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                            <TextBlock x:Name="AuditRatingText" Text="🛡️ EXCELLENT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Passed Card -->
                <Border Grid.Column="1" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="AuditPassedCountText" DockPanel.Dock="Right" Text="0" FontSize="20" FontWeight="Bold" Foreground="#00FF88" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HEALTHY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Passed Checks" FontSize="11" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Warnings Card -->
                <Border Grid.Column="2" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="AuditWarningCountText" DockPanel.Dock="Right" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WARNINGS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Can Be Improved" FontSize="11" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Critical Card -->
                <Border Grid.Column="3" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="AuditCriticalCountText" DockPanel.Dock="Right" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Magenta}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CRITICAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift"/>
                            <TextBlock Text="Action Needed" FontSize="11" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Findings List -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10">
            <ListBox x:Name="FindingsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <!-- Action Button on Right -->
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Content="{Binding FixActionLabel}" Click="OnFindingActionClick" Tag="{Binding}"
                                            Visibility="{Binding FixActionLabel, Converter={x:Null}}"
                                            Padding="12,4" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                                </StackPanel>

                                <!-- Details -->
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0" Background="#161B30" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <TextBlock Text="{Binding SeverityBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding SeverityColor}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" FontFamily="Bahnschrift" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick" Padding="14,4"/>
            <TextBlock x:Name="AuditTimestampText" Text="Audit ready." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}"/>
        </DockPanel>
    </Grid>
</Window>
