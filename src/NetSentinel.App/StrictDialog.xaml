<Window x:Class="NetSentinel.Ui.StrictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable strict mode" SizeToContent="Height" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock Text="Enable strict mode?" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Magenta}"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="From now on every program WITHOUT an explicit permission loses its outgoing network access. This is the strictest setting NetSentinel offers. Windows' basics (DHCP, DNS, Windows services, Windows Defender) and NetSentinel itself stay allowed, and so does every program you allowed or trust."/>

        <TextBlock Text="SAFETY NET" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,16,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="Right after switching on you get 60 seconds to confirm that your network still works. Without confirmation NetSentinel switches strict mode off again by itself, also after a crash or restart. If you are ever locked out, start NetSentinel as Administrator and press the PANIC button, or run this in an administrator command prompt:"/>
        <TextBox Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 Text="netsh advfirewall set allprofiles firewallpolicy blockinbound,allowoutbound"/>

        <TextBlock Text="BEFORE YOU START" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,16,0,6"/>
        <CheckBox x:Name="AllowRunningBox" IsChecked="True" Margin="0,0,0,8">
            <TextBlock x:Name="AllowRunningText" TextWrapping="Wrap"/>
        </CheckBox>
        <CheckBox x:Name="AuditBox" IsChecked="True">
            <TextBlock TextWrapping="Wrap"
                       Text="Switch on Windows' audit of blocked connections (needed to show what strict mode blocked, so NetSentinel can ask you). Changes a Windows audit setting; blocked attempts are written to the Security log."/>
        </CheckBox>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="Good to know: Microsoft Store apps and some Windows components may need extra attention. If something stops working, NetSentinel shows what was blocked and asks you."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Enable strict mode" Click="OnEnable" Margin="0,0,10,0" Foreground="{StaticResource Magenta}"/>
            <Button Content="Cancel" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
