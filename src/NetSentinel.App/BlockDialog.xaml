<Window x:Class="NetSentinel.Ui.BlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block program" SizeToContent="Height" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Magenta}" TextWrapping="Wrap"/>
        <TextBlock x:Name="PathText" Margin="0,6,0,16" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}"/>

        <TextBlock Text="DIRECTION" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="BothRadio" IsChecked="True" GroupName="direction" Margin="0,0,24,0" Content="Incoming and outgoing" Checked="OnInputChanged"/>
            <RadioButton x:Name="OutRadio" GroupName="direction" Margin="0,0,24,0" Content="Outgoing only" Checked="OnInputChanged"/>
            <RadioButton x:Name="InRadio" GroupName="direction" Content="Incoming only" Checked="OnInputChanged"/>
        </StackPanel>

        <TextBlock Text="WHAT TO BLOCK" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="0,0,0,6"/>
        <RadioButton x:Name="ModeAll" IsChecked="True" GroupName="mode" Margin="0,0,0,6"
                     Content="Everything (the program gets no network access in that direction)" Checked="OnInputChanged"/>
        <RadioButton x:Name="ModeMatching" GroupName="mode" Margin="0,0,0,6"
                     Content="Only traffic that matches the conditions below" Checked="OnInputChanged"/>
        <RadioButton x:Name="ModeAllowOnly" GroupName="mode" Margin="0,0,0,8"
                     Content="Allow ONLY traffic that matches the conditions below, block everything else" Checked="OnInputChanged"/>

        <Border x:Name="Conditions" Margin="24,0,0,0" Padding="14,12" IsEnabled="False"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Protocol" Width="110" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ProtoAny" IsChecked="True" GroupName="proto" Margin="0,0,20,0" Content="Any" Checked="OnInputChanged"/>
                    <RadioButton x:Name="ProtoTcp" GroupName="proto" Margin="0,0,20,0" Content="TCP" Checked="OnInputChanged"/>
                    <RadioButton x:Name="ProtoUdp" GroupName="proto" Content="UDP" Checked="OnInputChanged"/>
                </StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Ports" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="PortsBox" TextChanged="OnInputChanged"
                             ToolTip="The service port: the remote port for outgoing traffic, your local port for incoming traffic. Example: 443 or 80,443,8000-8100"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Addresses" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="AddressesBox" TextChanged="OnInputChanged"
                             ToolTip="The other side's addresses. Example: 203.0.113.7, 10.0.0.0/8, 198.51.100.1-198.51.100.50"/>
                </DockPanel>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="110,0,0,8"
                           Text="Ports: 443  or  80,443,8000-8100.   Addresses: 203.0.113.7, 10.0.0.0/8, 198.51.100.1-198.51.100.50. Leave a field empty for 'any'."/>
                <CheckBox x:Name="KeepLanBox" Content="Keep my local network reachable (private address ranges stay allowed)"
                          Margin="110,0,0,0" Checked="OnInputChanged" Unchecked="OnInputChanged"
                          ToolTip="Only for 'Allow ONLY': traffic to your own PC, router and LAN devices is never blocked."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{StaticResource Magenta}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SummaryText" Margin="0,12,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="Takes effect immediately. Anything else that uses this same exe is affected too. To undo: Rules view, Forget decision, or the panic button."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BlockButton" Content="Block" Click="OnBlock" Margin="0,0,10,0" Foreground="{StaticResource Magenta}"/>
            <Button Content="Cancel" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
