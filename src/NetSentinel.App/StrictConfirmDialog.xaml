<Window x:Class="NetSentinel.Ui.StrictConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strict mode: is your network still working?" SizeToContent="Height" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock Text="Strict mode is ON. Is your network still working?" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource Magenta}" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Try opening a web page or check that your usual programs still connect. If you do nothing, strict mode switches itself off when the time runs out."/>
        <TextBlock x:Name="CountdownText" Margin="0,16,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
        <TextBlock x:Name="ProbeText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="Checking the connection..."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Keep strict mode" Click="OnKeep" Margin="0,0,10,0" Foreground="{StaticResource Cyan}"/>
            <Button Content="Turn off now" IsCancel="True" IsDefault="True" Foreground="{StaticResource Magenta}"/>
        </StackPanel>
    </StackPanel>
</Window>
